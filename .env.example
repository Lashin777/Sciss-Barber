# Required application settings. Keep real values in the local .env file only.
MONGO_URI=
PORT=3000
TZ=Asia/Calcutta
JWT_SECRET=
EMAIL_USER=
EMAIL_PASS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NODE_ENV=development

# Optional profile image storage. When unset, uploads remain in the existing local uploads folder.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional explicit recipient; otherwise notifications go to the first ADMIN account email.
SHOP_ADMIN_EMAIL=
