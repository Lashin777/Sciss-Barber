extends ../layouts/minimal

block content
  section(class="mx-auto w-full max-w-6xl flex-1 py-5 sm:py-8")
    nav(class="mb-8 flex items-center justify-between border-b border-neutral-200 pb-4")
      a(href="/profile", class="font-mono text-[9px] font-bold tracking-[0.15em] text-neutral-500 transition hover:text-[#00D06C]") ← BACK TO PROFILE
      a(href="/", class="font-mono text-base font-bold tracking-[-0.08em] transition hover:text-[#00D06C]") SCISS’

    header(class="mb-8 flex flex-col gap-5 sm:mb-10 sm:flex-row sm:items-end sm:justify-between")
      div
        p(class="mb-3 font-mono text-[10px] tracking-[0.28em] text-neutral-400") MEMBER SPACE / 02
        h1(class="max-w-2xl text-4xl font-bold leading-[0.94] tracking-[-0.06em] sm:text-6xl") Your visits.<br>Your history.
        p(class="mt-4 text-sm text-neutral-500 sm:text-base") A record of your past SCISS’ appointments.
      a(href="/booking", class="inline-flex h-11 shrink-0 items-center justify-center rounded-full border border-neutral-300 px-5 font-mono text-[9px] font-bold tracking-[0.12em] transition hover:border-[#00D06C] hover:bg-[#00D06C] hover:text-black") BOOK AGAIN →

    div#booking-history-tabs(class="mb-8 inline-flex w-fit rounded-full border border-neutral-200 bg-neutral-100 p-1", role="tablist", aria-label="Booking lists")
      button#upcoming-tab(type="button", role="tab", aria-selected="true", aria-controls="upcoming-panel", class="rounded-full bg-[#00D06C] px-5 py-2.5 font-mono text-[9px] font-bold tracking-[0.12em] text-black transition") UPCOMING
      button#past-tab(type="button", role="tab", aria-selected="false", aria-controls="past-panel", class="rounded-full px-5 py-2.5 font-mono text-[9px] font-bold tracking-[0.12em] text-neutral-500 transition hover:bg-white") PAST

    section#upcoming-panel(class="mb-10", role="tabpanel", aria-labelledby="upcoming-tab")
      div(class="mb-5 flex items-end justify-between gap-4 border-b border-neutral-200 pb-4")
        h2#upcoming-bookings-heading(class="text-2xl font-bold tracking-[-0.04em]") Upcoming appointments
        span(class="font-mono text-[9px] tracking-[0.16em] text-neutral-400") MY BOOKINGS

      p#upcoming-loading(class="text-sm text-neutral-500", role="status", aria-live="polite") Loading your upcoming appointments…
      div#upcoming-error(class="hidden rounded-xl border border-neutral-200 bg-red-50 p-5", role="alert")
        p#upcoming-error-message(class="text-sm text-red-700") We couldn’t load your upcoming appointments.
        button#upcoming-retry(type="button", class="mt-3 inline-flex h-9 items-center justify-center rounded-full border border-neutral-300 px-4 font-mono text-[9px] font-bold tracking-[0.12em] text-neutral-700 transition hover:border-[#00D06C] hover:bg-[#00D06C] hover:text-black") TRY AGAIN
      div#upcoming-list(class="hidden grid gap-3 sm:grid-cols-2")
      article#upcoming-empty(class="hidden rounded-2xl border border-neutral-200 p-5 text-sm text-neutral-500") No upcoming appointments.

    section#past-panel(class="hidden", role="tabpanel", aria-labelledby="past-tab", hidden)
      div(class="mb-5 flex items-end justify-between gap-4 border-b border-neutral-200 pb-4")
        h2#booking-history-heading(class="text-2xl font-bold tracking-[-0.04em]") Past appointments
        span(class="font-mono text-[9px] tracking-[0.16em] text-neutral-400") BOOKING HISTORY

      p#history-loading(class="text-sm text-neutral-500", role="status", aria-live="polite") Loading your booking history…
      div#history-error(class="hidden rounded-xl border border-neutral-200 bg-red-50 p-5", role="alert")
        p#history-error-message(class="text-sm text-red-700") We couldn’t load your booking history.
        button#history-retry(type="button", class="mt-3 inline-flex h-9 items-center justify-center rounded-full border border-neutral-300 px-4 font-mono text-[9px] font-bold tracking-[0.12em] text-neutral-700 transition hover:border-[#00D06C] hover:bg-[#00D06C] hover:text-black") TRY AGAIN
      div#history-list(class="hidden grid gap-3 sm:grid-cols-2")
      article#history-empty(class="hidden flex-col gap-5 rounded-[1.5rem] border border-neutral-200 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6")
        div(class="flex items-start gap-4")
          span(class="grid size-12 shrink-0 place-items-center rounded-full bg-[#00D06C] text-xl text-black", aria-hidden="true") ✳
          div
            h3(class="text-xl font-bold tracking-[-0.04em]") No past appointments yet
            p(class="mt-2 text-sm text-neutral-500") Your previous visits will appear here.
        a(href="/booking", class="inline-flex h-11 shrink-0 items-center justify-center rounded-full border border-neutral-300 px-5 font-mono text-[9px] font-bold tracking-[0.12em] transition hover:border-[#00D06C] hover:bg-[#00D06C] hover:text-black") BOOK AN APPOINTMENT →

    dialog#cancel-booking-dialog(class="m-auto w-[calc(100%-2rem)] max-w-md overflow-hidden rounded-2xl border border-neutral-200 bg-white p-0 shadow-2xl backdrop:bg-black/60", aria-labelledby="cancel-booking-title", aria-describedby="cancel-booking-message")
      div(class="p-6 sm:p-8")
        p(class="mb-3 font-mono text-[9px] font-bold tracking-[0.2em] text-red-600") BOOKING CANCELLATION
        h2#cancel-booking-title(class="text-2xl font-bold tracking-[-0.05em]") Cancel this booking?
        p#cancel-booking-message(class="mt-3 text-sm leading-relaxed text-neutral-500") Are you sure you want to cancel this appointment?
        p#cancel-booking-error(class="mt-4 hidden rounded-lg border border-red-200 bg-red-50 p-3 text-xs text-red-700", role="alert")
        div(class="mt-7 flex flex-col-reverse justify-end gap-3 sm:flex-row")
          button#keep-booking(type="button", class="h-11 rounded-full border border-neutral-300 px-5 font-mono text-[9px] font-bold tracking-[0.1em] transition hover:border-neutral-950") KEEP BOOKING
          button#confirm-cancel-booking(type="button", class="h-11 rounded-full bg-red-600 px-5 font-mono text-[9px] font-bold tracking-[0.1em] text-white transition hover:bg-red-700 disabled:cursor-not-allowed disabled:opacity-50") CONFIRM CANCELLATION

    footer(class="mt-8 flex flex-wrap items-center justify-between gap-3 border-t border-neutral-200 pt-4 font-mono text-[9px] tracking-[0.12em] text-neutral-400")
      span SCISS’ BARBER · KOZHIKODE

  script.
    const historyLoading = document.getElementById('history-loading');
    const historyError = document.getElementById('history-error');
    const historyErrorMessage = document.getElementById('history-error-message');
    const historyList = document.getElementById('history-list');
    const historyEmpty = document.getElementById('history-empty');
    const historyRetry = document.getElementById('history-retry');
    const upcomingLoading = document.getElementById('upcoming-loading');
    const upcomingError = document.getElementById('upcoming-error');
    const upcomingErrorMessage = document.getElementById('upcoming-error-message');
    const upcomingList = document.getElementById('upcoming-list');
    const upcomingEmpty = document.getElementById('upcoming-empty');
    const upcomingRetry = document.getElementById('upcoming-retry');
    const cancelBookingDialog = document.getElementById('cancel-booking-dialog');
    const cancelBookingMessage = document.getElementById('cancel-booking-message');
    const cancelBookingError = document.getElementById('cancel-booking-error');
    const keepBookingButton = document.getElementById('keep-booking');
    const confirmCancelBookingButton = document.getElementById('confirm-cancel-booking');
    let bookingToCancel = null;
    let cancelButtonInProgress = null;

    const upcomingTab = document.getElementById('upcoming-tab');
    const pastTab = document.getElementById('past-tab');
    const upcomingPanel = document.getElementById('upcoming-panel');
    const pastPanel = document.getElementById('past-panel');

    function selectBookingTab(selectedTab) {
      const showUpcoming = selectedTab === upcomingTab;
      upcomingTab.setAttribute('aria-selected', String(showUpcoming));
      pastTab.setAttribute('aria-selected', String(!showUpcoming));
      upcomingTab.classList.toggle('bg-[#00D06C]', showUpcoming);
      upcomingTab.classList.toggle('text-black', showUpcoming);
      upcomingTab.classList.toggle('text-neutral-500', !showUpcoming);
      upcomingTab.classList.toggle('hover:bg-white', !showUpcoming);
      pastTab.classList.toggle('bg-[#00D06C]', !showUpcoming);
      pastTab.classList.toggle('text-black', !showUpcoming);
      pastTab.classList.toggle('text-neutral-500', showUpcoming);
      pastTab.classList.toggle('hover:bg-white', showUpcoming);
      upcomingPanel.classList.toggle('hidden', !showUpcoming);
      pastPanel.classList.toggle('hidden', showUpcoming);
      pastPanel.hidden = showUpcoming;
    }

    upcomingTab.addEventListener('click', () => selectBookingTab(upcomingTab));
    pastTab.addEventListener('click', () => selectBookingTab(pastTab));

    const formatHistoryDate = (value) => {
      if (!value) return 'Date unavailable';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return 'Date unavailable';
      return date.toLocaleDateString('en-IN', {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        timeZone: 'Asia/Kolkata'
      });
    };

    const formatHistoryTime = (value) => {
      if (!value) return 'Time unavailable';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return 'Time unavailable';
      return date.toLocaleTimeString('en-IN', {
        hour: '2-digit',
        minute: '2-digit',
        hour12: true,
        timeZone: 'Asia/Kolkata'
      });
    };

    const setHistoryState = (state) => {
      historyLoading.classList.toggle('hidden', state !== 'loading');
      historyError.classList.toggle('hidden', state !== 'error');
      historyList.classList.toggle('hidden', state !== 'list');
      historyEmpty.classList.toggle('hidden', state !== 'empty');
      historyEmpty.classList.toggle('flex', state === 'empty');
    };

    const setUpcomingState = (state) => {
      upcomingLoading.classList.toggle('hidden', state !== 'loading');
      upcomingError.classList.toggle('hidden', state !== 'error');
      upcomingList.classList.toggle('hidden', state !== 'list');
      upcomingEmpty.classList.toggle('hidden', state !== 'empty');
    };

    const createHistoryCard = (booking, showCancelButton = false) => {
      const card = document.createElement('article');
      card.className = 'min-w-0 rounded-2xl border border-neutral-200 p-5 sm:p-6';

      const header = document.createElement('div');
      header.className = 'flex flex-wrap items-start justify-between gap-3';

      const service = document.createElement('h3');
      service.className = 'min-w-0 break-words text-xl font-bold tracking-[-0.04em]';
      const serviceName = booking.serviceSnapshots?.length
        ? booking.serviceSnapshots.map((service) => service?.name).filter(Boolean).join(', ')
        : booking.serviceIds?.length
        ? booking.serviceIds.map((service) => service?.name).filter(Boolean).join(', ')
        : booking.serviceId?.name;
      service.textContent = serviceName || 'Service unavailable';

      const status = document.createElement('span');
      status.className = 'shrink-0 rounded-full px-3 py-1.5 font-mono text-[9px] font-bold tracking-[0.1em]';
      const statusKey = String(booking.status || '').toUpperCase() === 'FAILED'
        || (String(booking.status || '').toUpperCase() === 'PENDING'
        && String(booking.payment?.status || '').toUpperCase() === 'FAILED')
        ? 'PAYMENT FAILED'
        : String(booking.status || '').toUpperCase();
      status.textContent = statusKey || 'STATUS UNAVAILABLE';
      const statusColors = {
        PENDING: { backgroundColor: '#ffedd5', color: '#9a3412' },
        FAILED: { backgroundColor: '#fee2e2', color: '#b91c1c' },
        'PAYMENT FAILED': { backgroundColor: '#fee2e2', color: '#b91c1c' },
        CONFIRMED: { backgroundColor: '#dcfce7', color: '#166534' },
        ACCEPTED: { backgroundColor: '#dcfce7', color: '#166534' },
        COMPLETED: { backgroundColor: '#dcfce7', color: '#166534' },
        CANCELLED: { backgroundColor: '#fee2e2', color: '#b91c1c' },
        DECLINED: { backgroundColor: '#fee2e2', color: '#b91c1c' }
      };
      Object.assign(status.style, statusColors[statusKey] || { backgroundColor: '#f5f5f5', color: '#404040' });
      header.append(service, status);

      const details = document.createElement('div');
      details.className = 'mt-4 grid min-w-0 gap-3 sm:grid-cols-2';

      const addDetail = (label, value) => {
        const item = document.createElement('div');
        item.className = 'min-w-0';
        const title = document.createElement('p');
        title.className = 'font-mono text-[9px] tracking-[0.18em] text-neutral-400';
        title.textContent = label;
        const text = document.createElement('p');
        text.className = 'mt-1 break-words text-sm font-medium';
        text.textContent = value;
        item.append(title, text);
        details.appendChild(item);
      };

      addDetail('DATE', formatHistoryDate(booking.appointmentDate || booking.appointmentStart));
      addDetail('TIME', `${formatHistoryTime(booking.appointmentStart)} — ${formatHistoryTime(booking.appointmentEnd)}`);
      addDetail('BARBER', booking.barberId?.name || 'Barber unavailable');

      const link = document.createElement('a');
      link.className = 'inline-flex h-10 items-center rounded-full border border-neutral-300 px-4 py-2 font-mono text-[9px] font-bold tracking-[0.12em] transition hover:border-[#00D06C] hover:bg-[#00D06C] hover:text-black';
      link.href = `/bookings/${encodeURIComponent(booking._id)}`;
      link.textContent = 'VIEW DETAILS →';

      const actions = document.createElement('div');
      actions.className = 'mt-5 flex flex-wrap gap-2';
      actions.appendChild(link);

      const start = new Date(booking?.appointmentStart).getTime();
      const bookingIsCancellable = showCancelButton
        && !['COMPLETED', 'CANCELLED', 'DECLINED'].includes(statusKey);

      if (bookingIsCancellable) {
        const canCancel = Number.isFinite(start)
          && start - Date.now() > 3 * 60 * 60 * 1000;
        const cancelButton = document.createElement('button');
        cancelButton.type = 'button';
        cancelButton.className = canCancel
          ? 'inline-flex h-10 items-center rounded-full bg-red-600 px-4 py-2 font-mono text-[9px] font-bold tracking-[0.12em] text-white transition hover:bg-red-700 disabled:cursor-not-allowed disabled:opacity-50'
          : 'inline-flex h-10 cursor-not-allowed items-center rounded-full bg-neutral-200 px-4 py-2 font-mono text-[9px] font-bold tracking-[0.12em] text-neutral-500';
        cancelButton.textContent = 'CANCEL BOOKING';
        cancelButton.disabled = !canCancel;
        if (!canCancel) {
          cancelButton.title = 'Cancellation is available until 3 hours before the appointment.';
          cancelButton.setAttribute('aria-label', 'Cancel booking unavailable within 3 hours of the appointment');
        }
        cancelButton.addEventListener('click', () => {
          if (cancelButton.disabled || cancelBookingDialog.open) return;
          bookingToCancel = booking;
          cancelButtonInProgress = cancelButton;
          cancelBookingError.classList.add('hidden');
          cancelBookingError.textContent = '';
          cancelBookingMessage.textContent = `Cancel ${serviceName || 'this service'} on ${formatHistoryDate(booking.appointmentStart)} at ${formatHistoryTime(booking.appointmentStart)}? This action can’t be undone.`;
          cancelBookingDialog.showModal();
        });
        actions.appendChild(cancelButton);
      }

      card.append(header, details, actions);
      return card;
    };

    const loadUpcomingBookings = async () => {
      setUpcomingState('loading');
      upcomingErrorMessage.textContent = 'We couldn’t load your upcoming appointments.';
      upcomingList.replaceChildren();

      try {
        const response = await fetch('/api/bookings/my-bookings', {
          credentials: 'same-origin',
          headers: { Accept: 'application/json' }
        });
        const result = await response.json();
        if (!response.ok || result?.success !== true || !Array.isArray(result.bookings)) {
          throw new Error(result?.message || 'We couldn’t load your upcoming appointments. Please try again.');
        }

        const now = Date.now();
        const upcomingBookings = result.bookings
          .filter((booking) => {
            const start = new Date(booking?.appointmentStart).getTime();
            const status = String(booking?.status || '').toUpperCase();
            return booking?._id && Number.isFinite(start) && start >= now && !['CANCELLED', 'COMPLETED', 'DECLINED'].includes(status);
          })
          .sort((a, b) => new Date(a.appointmentStart).getTime() - new Date(b.appointmentStart).getTime());

        if (upcomingBookings.length === 0) {
          setUpcomingState('empty');
          return;
        }

        upcomingBookings.forEach((booking) => upcomingList.appendChild(createHistoryCard(booking, true)));
        setUpcomingState('list');
      } catch (error) {
        upcomingErrorMessage.textContent = error.message || 'We couldn’t load your upcoming appointments. Please try again.';
        setUpcomingState('error');
      }
    };

    const loadBookingHistory = async () => {
      setHistoryState('loading');
      historyErrorMessage.textContent = 'We couldn’t load your booking history.';
      historyList.replaceChildren();

      try {
        const response = await fetch('/api/bookings/history', {
          credentials: 'same-origin',
          headers: { Accept: 'application/json' }
        });
        const result = await response.json();
        if (!response.ok || result?.success !== true || !Array.isArray(result.bookings)) {
          throw new Error(result?.message || 'We couldn’t load your booking history. Please try again.');
        }

        const now = Date.now();
        const pastBookings = result.bookings
          .filter((booking) => {
            const start = new Date(booking?.appointmentStart).getTime();
            const status = String(booking?.status || '').toUpperCase();
            return booking?._id && Number.isFinite(start) && (start < now || status === 'COMPLETED');
          })
          .sort((a, b) => new Date(b.appointmentStart).getTime() - new Date(a.appointmentStart).getTime());

        if (pastBookings.length === 0) {
          setHistoryState('empty');
          return;
        }

        pastBookings.forEach((booking) => historyList.appendChild(createHistoryCard(booking)));
        setHistoryState('list');
      } catch (error) {
        historyErrorMessage.textContent = error.message || 'We couldn’t load your booking history. Please try again.';
        setHistoryState('error');
      }
    };

    historyRetry.addEventListener('click', loadBookingHistory);
    loadBookingHistory();
    upcomingRetry.addEventListener('click', loadUpcomingBookings);
    loadUpcomingBookings();

    keepBookingButton.addEventListener('click', () => cancelBookingDialog.close());
    cancelBookingDialog.addEventListener('click', (event) => {
      if (event.target === cancelBookingDialog && !confirmCancelBookingButton.disabled) cancelBookingDialog.close();
    });
    cancelBookingDialog.addEventListener('cancel', (event) => {
      if (confirmCancelBookingButton.disabled) event.preventDefault();
    });
    cancelBookingDialog.addEventListener('close', () => {
      bookingToCancel = null;
      cancelButtonInProgress = null;
    });
    confirmCancelBookingButton.addEventListener('click', async () => {
      if (!bookingToCancel || confirmCancelBookingButton.disabled) return;

      confirmCancelBookingButton.disabled = true;
      confirmCancelBookingButton.textContent = 'CANCELLING…';
      if (cancelButtonInProgress) {
        cancelButtonInProgress.disabled = true;
        cancelButtonInProgress.textContent = 'CANCELLING…';
      }
      cancelBookingError.classList.add('hidden');
      cancelBookingError.textContent = '';

      try {
        const response = await fetch(`/api/bookings/${encodeURIComponent(bookingToCancel._id)}/cancel`, {
          method: 'PATCH',
          credentials: 'same-origin',
          headers: { Accept: 'application/json' }
        });
        const result = await response.json();
        if (!response.ok || result?.success !== true) {
          throw new Error(result?.message || 'Could not cancel this booking. Please try again.');
        }
        cancelBookingDialog.close();
        await Promise.all([loadUpcomingBookings(), loadBookingHistory()]);
      } catch (error) {
        cancelBookingError.textContent = error.message || 'Could not cancel this booking. Please try again.';
        cancelBookingError.classList.remove('hidden');
        if (cancelButtonInProgress) {
          cancelButtonInProgress.disabled = false;
          cancelButtonInProgress.textContent = 'CANCEL BOOKING';
        }
      } finally {
        confirmCancelBookingButton.disabled = false;
        confirmCancelBookingButton.textContent = 'CONFIRM CANCELLATION';
      }
    });
