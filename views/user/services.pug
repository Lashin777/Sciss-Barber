extends ../layouts/minimal.pug

block content
  - const serviceGroupList = typeof serviceGroups !== 'undefined' && Array.isArray(serviceGroups) ? serviceGroups : []

  div(class="services-page-content mx-auto w-full max-w-7xl flex-1 px-2 py-8 sm:px-5 sm:py-12 lg:px-10")
    div(class="mb-12 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between")
      div
        a(href="/", class="mb-8 inline-block font-mono text-[10px] font-bold tracking-[0.15em] text-neutral-500 transition hover:text-[#00D06C]") ← BACK HOME
        p(class="mb-4 font-mono text-[10px] tracking-[0.3em] text-neutral-400") SCISS’ BARBER · KOZHIKODE
        h1(class="text-[clamp(3.5rem,9vw,7rem)] font-bold leading-[0.88] tracking-[-0.08em]")
          | SERVICES
          br
          | & PRICES.
      div(class="max-w-xs")
        p(class="mb-5 text-sm leading-relaxed text-neutral-500") Browse the full service menu. All prices are in Indian rupees.
        a(href="/booking", class="inline-flex h-12 items-center justify-center rounded-full bg-[#00D06C] px-6 font-mono text-xs font-bold tracking-[0.12em] text-black transition hover:bg-neutral-950 hover:text-white") BOOK NOW →

    div(class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3")
      if serviceGroupList.length
        each group, index in serviceGroupList
          article(class="rounded-2xl border border-neutral-200 bg-white p-5 sm:p-6")
            p(class="mb-5 font-mono text-[10px] tracking-[0.22em] text-[#00D06C]")= `${String(index + 1).padStart(2, '0')} / ${String(group.title || 'Services').toUpperCase()}`
            ul(class="space-y-3")
              each service in group.items
                li(class="flex items-baseline justify-between gap-4 border-b border-neutral-100 pb-2.5 text-sm last:border-0 last:pb-0")
                  div(class="min-w-0")
                    span(class="text-neutral-600")= service.name
                    if Number.isFinite(Number(service.duration)) && Number(service.duration) > 0
                      span(class="mt-1 block text-xs text-neutral-400") #{service.duration} min
                  span(class="shrink-0 font-mono text-xs font-bold text-neutral-950")= service.price !== null && service.price !== undefined && Number.isFinite(Number(service.price)) ? `₹${Number(service.price).toLocaleString('en-IN')}` : 'Price unavailable'
      else
        div(class="rounded-2xl border border-neutral-200 bg-white px-6 py-16 text-center sm:col-span-2 xl:col-span-3")
          p(class="font-mono text-[10px] font-bold tracking-[0.16em] text-neutral-400") SERVICES UNAVAILABLE
          p(class="mt-2 text-sm text-neutral-500") Services are currently unavailable.

  block auth_actions
