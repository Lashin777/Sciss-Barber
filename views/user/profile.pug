extends ../layouts/minimal

block content
  section(class="mx-auto w-full max-w-6xl flex-1 py-5 sm:py-8")
    nav(class="mb-8 flex items-center justify-between border-b border-neutral-200 pb-4")
      a(href="/", class="font-mono text-base font-bold tracking-[-0.08em] transition hover:text-[#00D06C]") SCISS’
      div(class="flex items-center gap-3")
        span(class="hidden font-mono text-[9px] tracking-[0.18em] text-neutral-400 sm:block") MEMBER SPACE
        button#profile-theme-toggle(type="button", aria-label="Switch theme", class="grid size-9 place-items-center rounded-full border border-neutral-200 text-base transition hover:border-[#00D06C] hover:bg-[#00D06C]") ◐
        //- Worked by Codex: provide direct customer logout from the profile header.
        form(action="/api/user/logout", method="POST")
          button(type="submit", class="inline-flex h-9 items-center gap-2 rounded-full border border-neutral-200 px-4 font-mono text-[9px] font-bold tracking-[0.1em] transition hover:border-[#00D06C] hover:bg-[#00D06C] hover:text-black") LOG OUT
        a(href="/", class="inline-flex h-9 items-center gap-2 rounded-full border border-neutral-200 px-4 font-mono text-[9px] font-bold tracking-[0.1em] transition hover:border-[#00D06C] hover:bg-[#00D06C] hover:text-black")
          span(aria-hidden="true") ←
          | HOME

    header(class="mb-8 flex flex-col justify-between gap-5 sm:mb-10 sm:flex-row sm:items-end")
      div
        p(class="mb-3 font-mono text-[10px] tracking-[0.28em] text-neutral-400") MEMBER SPACE / 01
        h1(class="max-w-2xl text-4xl font-bold leading-[0.94] tracking-[-0.06em] sm:text-6xl") Your look.<br>Your details.
        p(class="mt-4 text-sm text-neutral-500 sm:text-base") Keep your profile and preferred address up to date.
      a(href="/profile/edit", class="inline-flex h-12 items-center justify-center gap-3 rounded-full bg-neutral-950 px-6 font-mono text-[10px] font-bold tracking-[0.13em] text-white transition hover:bg-[#00D06C] hover:text-black")
        span EDIT PROFILE
        span(aria-hidden="true") ↗

    div(class="grid gap-5 lg:grid-cols-2")
      div(class="space-y-5 lg:col-span-2")
        article(class="profile-hero-panel relative isolate overflow-hidden rounded-[1.75rem] bg-neutral-950 p-6 text-white sm:p-8")
          div(class="pointer-events-none absolute -right-10 -top-16 -z-10 size-64 rounded-full border-[35px] border-[#00D06C]/15")
          div(class="pointer-events-none absolute -right-3 -top-9 -z-10 size-48 rounded-full border border-[#00D06C]/40")
          div(class="flex flex-col gap-6 sm:flex-row sm:items-center")
            div(class="relative grid size-24 shrink-0 place-items-center overflow-hidden rounded-full border border-white/20 bg-[#00D06C] text-black")
              if user.profileImage
                img(src=user.profileImage, alt="Profile picture", class="absolute inset-0 h-full w-full rounded-full object-cover")
              else
                span(class="font-mono text-3xl font-bold tracking-[-0.1em]")= user.name.split(' ').map(part => part[0]).join('').toUpperCase()
            div(class="min-w-0")
              p(class="mb-2 font-mono text-[9px] tracking-[0.24em] text-white/50") SCISS’ MEMBER
              h2(class="text-3xl font-bold leading-none tracking-[-0.05em] text-white sm:text-4xl")=user.name
              p(class="mt-3 text-sm text-white/60") Kozhikode, Kerala
            div(class="sm:ml-auto sm:self-start")
              span(class="inline-flex items-center gap-2 rounded-full border border-white/15 px-3 py-2 font-mono text-[9px] tracking-[0.12em] text-white/70")
                span(class="size-1.5 rounded-full bg-[#00D06C]")
                | SCISS’ MEMBER
          div(class="mt-8 grid gap-4 border-t border-white/15 pt-5 sm:grid-cols-2")
            div
              p(class="font-mono text-[9px] tracking-[0.2em] text-white/45") EMAIL ADDRESS
              p(class="mt-2 break-all text-sm font-medium")=user.email
              span(class="mt-2 inline-flex items-center gap-1.5 font-mono text-[9px] tracking-[0.08em] text-[#00D06C]")
                span(class="grid size-3 place-items-center rounded-full bg-[#00D06C] text-[8px] text-black") ✓
                | VERIFIED
            div
              p(class="font-mono text-[9px] tracking-[0.2em] text-white/45") PHONE NUMBER
              p(class="mt-2 text-sm font-medium")=user.phone
              span(class="mt-2 font-mono text-[9px] tracking-[0.08em] text-white/45") AVAILABLE FOR APPOINTMENT UPDATES

      div(class="grid gap-5 sm:grid-cols-2 lg:col-span-2")
        article(class="rounded-[1.75rem] border border-neutral-200 p-6 sm:p-8")
          div(class="flex items-start justify-between gap-4")
            div
              p(class="mb-2 font-mono text-[9px] tracking-[0.24em] text-neutral-400") SCISS’ WALLET · PREVIEW
              h2(class="text-2xl font-bold tracking-[-0.04em]") Your credits
            span(class="grid size-10 place-items-center rounded-full bg-[#00D06C] text-lg text-black", aria-hidden="true") ₹
          div(class="mt-6 flex items-end justify-between border-b border-neutral-100 pb-5")
            p(class="text-4xl font-bold tracking-[-0.06em]") ₹0
            span(class="rounded-full bg-[#00D06C]/15 px-3 py-1.5 font-mono text-[8px] font-bold tracking-[0.1em]") AVAILABLE
          p(class="mt-4 text-sm leading-relaxed text-neutral-500") Earn wallet credits from eligible visits and referrals.
          div(class="mt-5 flex items-center justify-between gap-3 rounded-xl bg-neutral-50 px-4 py-3")
            span(class="font-mono text-[9px] tracking-[0.1em] text-neutral-400") WALLET ACTIVITY
            span(class="text-xs font-medium text-neutral-500") No activity yet

        article(class="rounded-[1.75rem] border border-neutral-200 p-6 sm:p-8")
          p(class="mb-2 font-mono text-[9px] tracking-[0.24em] text-neutral-400") GIVE A CUT. GET A CREDIT.
          h2(class="text-2xl font-bold tracking-[-0.04em]") Refer a friend
          p(class="mt-3 text-sm leading-relaxed text-neutral-500") Share your code. When a friend books, referral rewards can land in your wallet.
          div(class="mt-5 flex items-center justify-between gap-3 rounded-xl border border-dashed border-neutral-300 px-4 py-3")
          span#referral-code(class="font-mono text-xs font-bold tracking-[0.1em]")= user.referralCode
            button#copy-referral-code(type="button", class="font-mono text-[9px] font-bold tracking-[0.1em] text-neutral-500 transition hover:text-[#00D06C]") COPY
          p#referral-copy-feedback(class="mt-3 hidden text-xs font-medium text-green-700", role="status") Referral code copied.

    article(class="mt-5 flex flex-col gap-5 rounded-[1.75rem] border border-neutral-200 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8")
      div(class="flex items-start gap-4")
        span(class="grid size-12 shrink-0 place-items-center rounded-full bg-[#00D06C] text-xl text-black", aria-hidden="true") ✳
        div
          p(class="mb-2 font-mono text-[9px] tracking-[0.24em] text-neutral-400") YOUR NEXT VISIT
          h2(class="text-2xl font-bold tracking-[-0.04em]") No appointment booked yet
          p(class="mt-2 text-sm text-neutral-500") Whenever you’re ready, choose a service and find a time that works.
      a(href="/booking", class="inline-flex h-11 shrink-0 items-center justify-center rounded-full border border-neutral-300 px-5 font-mono text-[9px] font-bold tracking-[0.12em] transition hover:border-[#00D06C] hover:bg-[#00D06C] hover:text-black") BOOK AN APPOINTMENT →

    footer(class="mt-8 flex flex-wrap items-center justify-between gap-3 border-t border-neutral-200 pt-4 font-mono text-[9px] tracking-[0.12em] text-neutral-400")
      span SCISS’ BARBER · KOZHIKODE

  script.
    const profileThemeToggle = document.getElementById('profile-theme-toggle');
    const syncProfileTheme = () => {
      const isDark = document.documentElement.classList.contains('theme-dark');
      profileThemeToggle.setAttribute('aria-pressed', String(isDark));
      profileThemeToggle.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
    };
    syncProfileTheme();
    profileThemeToggle.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('theme-dark');
      try { localStorage.setItem('sciss-theme', isDark ? 'dark' : 'light'); } catch (error) {}
      syncProfileTheme();
    });

    document.getElementById('copy-referral-code').addEventListener('click', async () => {
      const code = document.getElementById('referral-code').textContent.trim();
      const feedback = document.getElementById('referral-copy-feedback');
      try {
        await navigator.clipboard.writeText(code);
        feedback.textContent = 'Referral code copied.';
      } catch (error) {
        feedback.textContent = `Your referral code: ${code}`;
      }
      feedback.classList.remove('hidden');
    });

    window.addEventListener('pageshow', function (event) {
      if (event.persisted) {
        window.location.reload();
      }
    });
