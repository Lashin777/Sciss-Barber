extends ../layouts/minimal

block content
  section(class="mx-auto w-full max-w-6xl flex-1 py-5 sm:py-8")
    nav(class="mb-8 flex items-center justify-between border-b border-neutral-200 pb-4")
      a(href="/", class="font-mono text-base font-bold tracking-[-0.08em] transition hover:text-[#00D06C]") SCISS’
      div(class="flex items-center gap-3")
        span(class="hidden font-mono text-[9px] tracking-[0.18em] text-neutral-400 sm:block") MEMBER SPACE
        a(href="/services", class="inline-flex h-9 items-center rounded-full border border-neutral-200 px-4 font-mono text-[9px] font-bold tracking-[0.1em] transition hover:border-[#00D06C] hover:bg-[#00D06C] hover:text-black") SERVICES
        button#profile-theme-toggle(type="button", aria-label="Switch theme", class="grid size-9 place-items-center rounded-full border border-neutral-200 text-base transition hover:border-[#00D06C] hover:bg-[#00D06C]") ◐
        //- Worked by Codex: provide direct customer logout from the profile header.
        form(action="/api/user/logout", method="POST")
          button(type="submit", class="inline-flex h-9 items-center gap-2 rounded-full border border-neutral-200 px-4 font-mono text-[9px] font-bold tracking-[0.1em] transition hover:border-[#00D06C] hover:bg-[#00D06C] hover:text-black") LOG OUT
        a(href="/", class="inline-flex h-9 items-center gap-2 rounded-full border border-neutral-200 px-4 font-mono text-[9px] font-bold tracking-[0.1em] transition hover:border-[#00D06C] hover:bg-[#00D06C] hover:text-black")
          span(aria-hidden="true") ←
          | HOME

    header(class="mb-8 flex flex-col justify-between gap-5 sm:mb-10 sm:flex-row sm:items-end")
      div
        p(class="mb-3 font-mono text-[10px] tracking-[0.28em] text-neutral-400") MEMBER SPACE / 01
        h1(class="max-w-2xl text-4xl font-bold leading-[0.94] tracking-[-0.06em] sm:text-6xl") Your look.<br>Your details.
        p(class="mt-4 text-sm text-neutral-500 sm:text-base") Keep your profile details up to date.
      a(href="/profile/edit", class="inline-flex h-12 items-center justify-center gap-3 rounded-full bg-neutral-950 px-6 font-mono text-[10px] font-bold tracking-[0.13em] text-white transition hover:bg-[#00D06C] hover:text-black")
        span EDIT PROFILE
        span(aria-hidden="true") ↗

    div(class="grid gap-5 lg:grid-cols-2")
      div(class="space-y-5 lg:col-span-2")
        article(class="profile-hero-panel relative isolate overflow-hidden rounded-[1.75rem] bg-neutral-950 p-6 text-white sm:p-8")
          div(class="pointer-events-none absolute -right-10 -top-16 -z-10 size-64 rounded-full border-[35px] border-[#00D06C]/15")
          div(class="pointer-events-none absolute -right-3 -top-9 -z-10 size-48 rounded-full border border-[#00D06C]/40")
          div(class="flex flex-col gap-6 sm:flex-row sm:items-center")
            div(class="relative grid size-24 shrink-0 place-items-center overflow-hidden rounded-full border border-white/20 bg-[#00D06C] text-black")
              if user.profileImage
                img(src=user.profileImage, alt="Profile picture", class="absolute inset-0 h-full w-full rounded-full object-cover")
              else
                span(class="font-mono text-3xl font-bold tracking-[-0.1em]")= user.name.split(' ').map(part => part[0]).join('').toUpperCase()
            div(class="min-w-0")
              p(class="mb-2 font-mono text-[9px] tracking-[0.24em] text-white/50") SCISS’ MEMBER
              h2(class="text-3xl font-bold leading-none tracking-[-0.05em] text-white sm:text-4xl")=user.name
              //- Worked by Codex: remove the profile's saved-location display with address management.
            div(class="sm:ml-auto sm:self-start")
              span(class="inline-flex items-center gap-2 rounded-full border border-white/15 px-3 py-2 font-mono text-[9px] tracking-[0.12em] text-white/70")
                span(class="size-1.5 rounded-full bg-[#00D06C]")
                | SCISS’ MEMBER
          div(class="mt-8 grid gap-4 border-t border-white/15 pt-5 sm:grid-cols-2")
            div
              p(class="font-mono text-[9px] tracking-[0.2em] text-white/45") EMAIL ADDRESS
              p(class="mt-2 break-all text-sm font-medium")=user.email
              span(class="mt-2 inline-flex items-center gap-1.5 font-mono text-[9px] tracking-[0.08em] text-[#00D06C]")
                span(class="grid size-3 place-items-center rounded-full bg-[#00D06C] text-[8px] text-black") ✓
                | VERIFIED
            div
              p(class="font-mono text-[9px] tracking-[0.2em] text-white/45") PHONE NUMBER
              p(class="mt-2 text-sm font-medium")=user.phone
              span(class="mt-2 font-mono text-[9px] tracking-[0.08em] text-white/45") AVAILABLE FOR APPOINTMENT UPDATES

      div(class="grid gap-5 sm:grid-cols-2 lg:col-span-2")
        article(class="rounded-[1.75rem] border border-neutral-200 p-6 sm:p-8")
          div(class="flex items-start justify-between gap-4")
            div
              p(class="mb-2 font-mono text-[9px] tracking-[0.24em] text-neutral-400") SCISS’ WALLET · PREVIEW
              h2(class="text-2xl font-bold tracking-[-0.04em]") Your credits
            span(class="grid size-10 place-items-center rounded-full bg-[#00D06C] text-lg text-black", aria-hidden="true") ₹
          div(class="mt-6 flex items-end justify-between border-b border-neutral-100 pb-5")
            p(class="text-4xl font-bold tracking-[-0.06em]") ₹0
            span(class="rounded-full bg-[#00D06C]/15 px-3 py-1.5 font-mono text-[8px] font-bold tracking-[0.1em]") AVAILABLE
          p(class="mt-4 text-sm leading-relaxed text-neutral-500") Earn wallet credits from eligible visits and referrals.
          div(class="mt-5 flex items-center justify-between gap-3 rounded-xl bg-neutral-50 px-4 py-3")
            span(class="font-mono text-[9px] tracking-[0.1em] text-neutral-400") WALLET ACTIVITY
            span(class="text-xs font-medium text-neutral-500") No activity yet

        article(class="rounded-[1.75rem] border border-neutral-200 p-6 sm:p-8")
          p(class="mb-2 font-mono text-[9px] tracking-[0.24em] text-neutral-400") GIVE A CUT. GET A CREDIT.
          h2(class="text-2xl font-bold tracking-[-0.04em]") Refer a friend
          p(class="mt-3 text-sm leading-relaxed text-neutral-500") Share your code. When a friend books, referral rewards can land in your wallet.
          //- Worked by Codex: keep the referral code and copy control inside their shared visual container.
          div(class="mt-5 flex items-center justify-between gap-3 rounded-xl border border-dashed border-neutral-300 px-4 py-3")
            span#referral-code(class="font-mono text-xs font-bold tracking-[0.1em]")= user.referralCode
            button#copy-referral-code(type="button", class="font-mono text-[9px] font-bold tracking-[0.1em] text-neutral-500 transition hover:text-[#00D06C]") COPY
          p#referral-copy-feedback(class="mt-3 hidden text-xs font-medium text-green-700", role="status") Referral code copied.

    section#profile-appointments(class="mt-5 rounded-[1.75rem] border border-neutral-200 p-6 sm:p-8", aria-labelledby="appointments-heading")
      div(class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between")
        div
          p(class="mb-2 font-mono text-[9px] tracking-[0.24em] text-neutral-400") YOUR NEXT VISIT
          h2#appointments-heading(class="text-2xl font-bold tracking-[-0.04em]") Upcoming appointments
        a(href="/bookings/history", class="w-fit font-mono text-[9px] font-bold tracking-[0.12em] text-neutral-500 transition hover:text-[#00D06C]") VIEW BOOKING HISTORY →

      p#appointments-loading(class="text-sm text-neutral-500", role="status", aria-live="polite") Loading your appointments…
      div#appointments-error(class="hidden rounded-xl border border-neutral-200 bg-red-50 p-5", role="alert")
        p#appointments-error-message(class="text-sm text-red-700") We couldn’t load your appointments.
        button#appointments-retry(type="button", class="mt-3 inline-flex h-9 items-center justify-center rounded-full border border-neutral-300 px-4 font-mono text-[9px] font-bold tracking-[0.12em] text-neutral-700 transition hover:border-[#00D06C] hover:bg-[#00D06C] hover:text-black") TRY AGAIN
      div#appointments-list(class="hidden grid gap-3 sm:grid-cols-2")
      article#appointments-empty(class="hidden flex-col gap-5 rounded-[1.5rem] border border-neutral-200 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6")
        div(class="flex items-start gap-4")
          span(class="grid size-12 shrink-0 place-items-center rounded-full bg-[#00D06C] text-xl text-black", aria-hidden="true") ✳
          div
            h3(class="text-xl font-bold tracking-[-0.04em]") No appointment booked yet
            p(class="mt-2 text-sm text-neutral-500") Whenever you’re ready, choose a service and find a time that works.
        a(href="/booking", class="inline-flex h-11 shrink-0 items-center justify-center rounded-full border border-neutral-300 px-5 font-mono text-[9px] font-bold tracking-[0.12em] transition hover:border-[#00D06C] hover:bg-[#00D06C] hover:text-black") BOOK AN APPOINTMENT →

      dialog#cancel-booking-dialog(class="m-auto w-[calc(100%-2rem)] max-w-md overflow-hidden rounded-2xl border border-neutral-200 bg-white p-0 shadow-2xl backdrop:bg-black/60", aria-labelledby="cancel-booking-title", aria-describedby="cancel-booking-message")
        div(class="p-6 sm:p-8")
          p(class="mb-3 font-mono text-[9px] font-bold tracking-[0.2em] text-red-600") BOOKING CANCELLATION
          h2#cancel-booking-title(class="text-2xl font-bold tracking-[-0.05em]") Cancel this booking?
          p#cancel-booking-message(class="mt-3 text-sm leading-relaxed text-neutral-500") Are you sure you want to cancel this appointment?
          p#cancel-booking-error(class="mt-4 hidden rounded-lg border border-red-200 bg-red-50 p-3 text-xs text-red-700", role="alert")
          div(class="mt-7 flex flex-col-reverse justify-end gap-3 sm:flex-row")
            button#keep-booking(type="button", class="h-11 rounded-full border border-neutral-300 px-5 font-mono text-[9px] font-bold tracking-[0.1em] transition hover:border-neutral-950") KEEP BOOKING
            button#confirm-cancel-booking(type="button", class="h-11 rounded-full bg-red-600 px-5 font-mono text-[9px] font-bold tracking-[0.1em] text-white transition hover:bg-red-700 disabled:cursor-not-allowed disabled:opacity-50") CONFIRM CANCELLATION

    footer(class="mt-8 flex flex-wrap items-center justify-between gap-3 border-t border-neutral-200 pt-4 font-mono text-[9px] tracking-[0.12em] text-neutral-400")
      span SCISS’ BARBER · KOZHIKODE

  script.
    const profileThemeToggle = document.getElementById('profile-theme-toggle');
    const syncProfileTheme = () => {
      const isDark = document.documentElement.classList.contains('theme-dark');
      profileThemeToggle.setAttribute('aria-pressed', String(isDark));
      profileThemeToggle.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
    };
    syncProfileTheme();
    profileThemeToggle.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('theme-dark');
      try { localStorage.setItem('sciss-theme', isDark ? 'dark' : 'light'); } catch (error) {}
      syncProfileTheme();
    });

    document.getElementById('copy-referral-code').addEventListener('click', async () => {
      const code = document.getElementById('referral-code').textContent.trim();
      const feedback = document.getElementById('referral-copy-feedback');
      try {
        await navigator.clipboard.writeText(code);
        feedback.textContent = 'Referral code copied.';
      } catch (error) {
        feedback.textContent = `Your referral code: ${code}`;
      }
      feedback.classList.remove('hidden');
    });

    const appointmentsLoading = document.getElementById('appointments-loading');
    const appointmentsError = document.getElementById('appointments-error');
    const appointmentsErrorMessage = document.getElementById('appointments-error-message');
    const appointmentsList = document.getElementById('appointments-list');
    const appointmentsEmpty = document.getElementById('appointments-empty');
    const appointmentsRetry = document.getElementById('appointments-retry');
    const cancelBookingDialog = document.getElementById('cancel-booking-dialog');
    const cancelBookingMessage = document.getElementById('cancel-booking-message');
    const cancelBookingError = document.getElementById('cancel-booking-error');
    const keepBookingButton = document.getElementById('keep-booking');
    const confirmCancelBookingButton = document.getElementById('confirm-cancel-booking');
    let bookingToCancel = null;
    let cancelButtonInProgress = null;

    const formatAppointmentDate = (value) => {
      if (!value) return 'Date unavailable';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return 'Date unavailable';
      return date.toLocaleDateString('en-IN', {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        timeZone: 'Asia/Kolkata'
      });
    };

    const formatAppointmentTime = (value) => {
      if (!value) return 'Time unavailable';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return 'Time unavailable';
      return date.toLocaleTimeString('en-IN', {
        hour: '2-digit',
        minute: '2-digit',
        hour12: true,
        timeZone: 'Asia/Kolkata'
      });
    };

    const setAppointmentsState = (state) => {
      appointmentsLoading.classList.toggle('hidden', state !== 'loading');
      appointmentsError.classList.toggle('hidden', state !== 'error');
      appointmentsList.classList.toggle('hidden', state !== 'list');
      appointmentsEmpty.classList.toggle('hidden', state !== 'empty');
      appointmentsEmpty.classList.toggle('flex', state === 'empty');
    };

    const createAppointmentCard = (booking) => {
      const card = document.createElement('article');
      card.className = 'min-w-0 rounded-2xl border border-neutral-200 p-5 sm:p-6';

      const header = document.createElement('div');
      header.className = 'flex flex-wrap items-start justify-between gap-3';

      const service = document.createElement('h3');
      service.className = 'min-w-0 break-words text-xl font-bold tracking-[-0.04em]';
      service.textContent = booking.serviceId?.name || 'Service unavailable';

      const status = document.createElement('span');
      status.className = 'shrink-0 rounded-full px-3 py-1.5 font-mono text-[9px] font-bold tracking-[0.1em]';
      status.textContent = booking.status || 'STATUS UNAVAILABLE';
      const statusKey = String(booking.status || '').toUpperCase();
      const statusColors = {
        PENDING: { backgroundColor: '#ffedd5', color: '#9a3412' },
        CONFIRMED: { backgroundColor: '#dcfce7', color: '#166534' },
        ACCEPTED: { backgroundColor: '#dcfce7', color: '#166534' },
        COMPLETED: { backgroundColor: '#dcfce7', color: '#166534' },
        CANCELLED: { backgroundColor: '#fee2e2', color: '#b91c1c' },
        DECLINED: { backgroundColor: '#fee2e2', color: '#b91c1c' }
      };
      Object.assign(status.style, statusColors[statusKey] || { backgroundColor: '#f5f5f5', color: '#404040' });
      header.append(service, status);

      const details = document.createElement('div');
      details.className = 'mt-4 grid min-w-0 gap-3 sm:grid-cols-2';

      const addDetail = (label, value) => {
        const item = document.createElement('div');
        item.className = 'min-w-0';
        const title = document.createElement('p');
        title.className = 'font-mono text-[9px] tracking-[0.18em] text-neutral-400';
        title.textContent = label;
        const text = document.createElement('p');
        text.className = 'mt-1 break-words text-sm font-medium';
        text.textContent = value;
        item.append(title, text);
        details.appendChild(item);
      };

      addDetail('DATE', formatAppointmentDate(booking.appointmentDate || booking.appointmentStart));
      addDetail('TIME', `${formatAppointmentTime(booking.appointmentStart)} — ${formatAppointmentTime(booking.appointmentEnd)}`);
      addDetail('BARBER', booking.barberId?.name || 'To be confirmed');

      const actions = document.createElement('div');
      actions.className = 'mt-5 flex flex-wrap gap-2';

      const link = document.createElement('a');
      link.className = 'inline-flex h-10 items-center rounded-full border border-neutral-300 px-4 py-2 font-mono text-[9px] font-bold tracking-[0.12em] transition hover:border-[#00D06C] hover:bg-[#00D06C] hover:text-black';
      link.href = `/bookings/${encodeURIComponent(booking._id)}`;
      link.textContent = 'VIEW DETAILS →';
      actions.appendChild(link);

      const appointmentStart = new Date(booking?.appointmentStart).getTime();
      const bookingIsCancellable = !['COMPLETED', 'CANCELLED', 'DECLINED'].includes(statusKey);
      if (bookingIsCancellable) {
        const canCancel = Number.isFinite(appointmentStart)
          && appointmentStart - Date.now() > 3 * 60 * 60 * 1000;
        const cancelButton = document.createElement('button');
        cancelButton.type = 'button';
        cancelButton.className = canCancel
          ? 'inline-flex h-10 items-center rounded-full bg-red-600 px-4 py-2 font-mono text-[9px] font-bold tracking-[0.12em] text-white transition hover:bg-red-700 disabled:cursor-not-allowed disabled:opacity-50'
          : 'inline-flex h-10 cursor-not-allowed items-center rounded-full bg-neutral-200 px-4 py-2 font-mono text-[9px] font-bold tracking-[0.12em] text-neutral-500';
        cancelButton.textContent = 'CANCEL BOOKING';
        cancelButton.disabled = !canCancel;
        if (!canCancel) {
          cancelButton.title = 'Cancellation is available until 3 hours before the appointment.';
          cancelButton.setAttribute('aria-label', 'Cancel booking unavailable within 3 hours of the appointment');
        }

        cancelButton.addEventListener('click', () => {
          if (cancelButton.disabled || cancelBookingDialog.open) return;
          bookingToCancel = booking;
          cancelButtonInProgress = cancelButton;
          cancelBookingError.classList.add('hidden');
          cancelBookingError.textContent = '';
          cancelBookingMessage.textContent = `Cancel ${booking.serviceId?.name || 'this service'} on ${formatAppointmentDate(booking.appointmentStart)} at ${formatAppointmentTime(booking.appointmentStart)}? This action can’t be undone.`;
          cancelBookingDialog.showModal();
        });

        actions.appendChild(cancelButton);
      }

      card.append(header, details, actions);
      return card;
    };

    const loadAppointments = async () => {
      setAppointmentsState('loading');
      appointmentsErrorMessage.textContent = 'We couldn’t load your appointments.';
      appointmentsList.replaceChildren();

      try {
        const response = await fetch('/api/bookings/my-bookings', {
          credentials: 'same-origin',
          headers: { Accept: 'application/json' }
        });
        const result = await response.json();
        if (!response.ok || result?.success !== true || !Array.isArray(result.bookings)) {
          throw new Error(result?.message || 'We couldn’t load your appointments. Please try again.');
        }

        const now = Date.now();
        const upcomingBookings = result.bookings
          .filter((booking) => {
            const start = new Date(booking?.appointmentStart).getTime();
            const status = String(booking?.status || '').toUpperCase();
            return booking?._id && Number.isFinite(start) && start >= now && !['CANCELLED', 'COMPLETED', 'DECLINED'].includes(status);
          })
          .sort((a, b) => new Date(a.appointmentStart).getTime() - new Date(b.appointmentStart).getTime());

        if (upcomingBookings.length === 0) {
          setAppointmentsState('empty');
          return;
        }

        upcomingBookings.forEach((booking) => appointmentsList.appendChild(createAppointmentCard(booking)));
        setAppointmentsState('list');
      } catch (error) {
        appointmentsErrorMessage.textContent = error.message || 'We couldn’t load your appointments. Please try again.';
        setAppointmentsState('error');
      }
    };

    appointmentsRetry.addEventListener('click', loadAppointments);
    loadAppointments();

    keepBookingButton.addEventListener('click', () => cancelBookingDialog.close());
    cancelBookingDialog.addEventListener('click', (event) => {
      if (event.target === cancelBookingDialog) cancelBookingDialog.close();
    });
    cancelBookingDialog.addEventListener('close', () => {
      bookingToCancel = null;
      cancelButtonInProgress = null;
    });
    confirmCancelBookingButton.addEventListener('click', async () => {
      if (!bookingToCancel || confirmCancelBookingButton.disabled) return;

      confirmCancelBookingButton.disabled = true;
      confirmCancelBookingButton.textContent = 'CANCELLING…';
      if (cancelButtonInProgress) {
        cancelButtonInProgress.disabled = true;
        cancelButtonInProgress.textContent = 'CANCELLING…';
      }
      cancelBookingError.classList.add('hidden');
      cancelBookingError.textContent = '';

      try {
        const response = await fetch(`/api/bookings/${encodeURIComponent(bookingToCancel._id)}/cancel`, {
          method: 'PATCH',
          credentials: 'same-origin',
          headers: { Accept: 'application/json' }
        });
        const result = await response.json();
        if (!response.ok || result?.success !== true) {
          throw new Error(result?.message || 'Could not cancel this booking. Please try again.');
        }
        cancelBookingDialog.close();
        await loadAppointments();
      } catch (error) {
        cancelBookingError.textContent = error.message || 'Could not cancel this booking. Please try again.';
        cancelBookingError.classList.remove('hidden');
        if (cancelButtonInProgress) {
          cancelButtonInProgress.disabled = false;
          cancelButtonInProgress.textContent = 'CANCEL BOOKING';
        }
      } finally {
        confirmCancelBookingButton.disabled = false;
        confirmCancelBookingButton.textContent = 'CONFIRM CANCELLATION';
      }
    });

    window.addEventListener('pageshow', function (event) {
      if (event.persisted) {
        window.location.reload();
      }
    });
