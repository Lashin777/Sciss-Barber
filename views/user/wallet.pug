extends ../layouts/minimal

block content
  section(class="mx-auto w-full max-w-6xl flex-1 py-5 sm:py-8")
    nav(class="mb-8 flex items-center justify-between border-b border-neutral-200 pb-4")
      a(href="/profile", class="font-mono text-[9px] font-bold tracking-[0.15em] text-neutral-500 transition hover:text-[#00D06C]") ← BACK TO PROFILE
      a(href="/", class="font-mono text-base font-bold tracking-[-0.08em] transition hover:text-[#00D06C]") SCISS’

    header(class="mb-8 flex flex-col justify-between gap-5 sm:mb-10 sm:flex-row sm:items-end")
      div
        p(class="mb-3 font-mono text-[10px] tracking-[0.28em] text-neutral-400") MEMBER SPACE / WALLET
        h1(class="max-w-2xl text-4xl font-bold leading-[0.94] tracking-[-0.06em] sm:text-6xl") Your wallet.
        p(class="mt-4 text-sm text-neutral-500 sm:text-base") View your available balance and wallet activity.
      a(href="/bookings/history", class="inline-flex h-11 shrink-0 items-center justify-center rounded-full border border-neutral-300 px-5 font-mono text-[9px] font-bold tracking-[0.12em] transition hover:border-[#00D06C] hover:bg-[#00D06C] hover:text-black") VIEW BOOKINGS →

    section#wallet(class="mt-5 scroll-mt-6 rounded-[1.75rem] border border-neutral-200 p-6 sm:p-8", aria-labelledby="wallet-heading")
      div(class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between")
        div
          p(class="mb-2 font-mono text-[9px] tracking-[0.24em] text-neutral-400") MEMBER SPACE / WALLET
          h2#wallet-heading(class="text-2xl font-bold tracking-[-0.04em]") Your wallet
        button#wallet-retry(type="button", class="inline-flex h-10 items-center justify-center rounded-full border border-neutral-300 px-4 font-mono text-[9px] font-bold tracking-[0.12em] transition hover:border-[#00D06C] hover:bg-[#00D06C] hover:text-black disabled:cursor-not-allowed disabled:opacity-50") REFRESH WALLET
      div(class="grid gap-5 lg:grid-cols-[0.7fr_1.3fr]")
        article(class="rounded-2xl bg-neutral-950 p-6 text-white sm:p-7")
          p(class="font-mono text-[9px] tracking-[0.2em] text-white/50") AVAILABLE BALANCE
          p#wallet-balance-loading(class="mt-5 text-sm text-white/60", role="status", aria-live="polite") Loading wallet balance…
          p#wallet-balance(class="mt-4 hidden text-4xl font-bold tracking-[-0.06em] text-[#00D06C]", aria-live="polite") —
          p(class="mt-2 font-mono text-[9px] tracking-[0.16em] text-white/50") CURRENCY · INR
          p#wallet-balance-error(class="mt-4 hidden text-sm leading-relaxed text-red-300", role="alert")
        article(class="min-w-0 rounded-2xl border border-neutral-200 p-5 sm:p-6")
          div(class="mb-4 flex flex-wrap items-end justify-between gap-3")
            div
              p(class="mb-1 font-mono text-[9px] tracking-[0.2em] text-neutral-400") WALLET ACTIVITY
              h3(class="text-lg font-bold tracking-tight") Transactions
            p(class="font-mono text-[9px] tracking-[0.12em] text-neutral-400") MOST RECENT FIRST
          p#wallet-transactions-loading(class="py-6 text-sm text-neutral-500", role="status", aria-live="polite") Loading transactions…
          p#wallet-transactions-error(class="hidden py-6 text-sm text-red-700", role="alert")
          p#wallet-transactions-empty(class="hidden rounded-xl border border-dashed border-neutral-300 px-4 py-8 text-center text-sm text-neutral-500") No wallet transactions yet.
          div#wallet-transactions-list(class="hidden space-y-3")
          nav#wallet-transactions-pagination(class="mt-5 hidden items-center justify-between gap-3", aria-label="Wallet transaction pages")
            button#wallet-transactions-previous(type="button", class="inline-flex h-9 items-center justify-center rounded-full border border-neutral-300 px-4 font-mono text-[9px] font-bold tracking-[0.12em] transition hover:border-[#00D06C] disabled:cursor-not-allowed disabled:opacity-40") PREVIOUS
            p#wallet-transactions-page(class="text-center font-mono text-[9px] tracking-[0.12em] text-neutral-500", aria-live="polite")
            button#wallet-transactions-next(type="button", class="inline-flex h-9 items-center justify-center rounded-full border border-neutral-300 px-4 font-mono text-[9px] font-bold tracking-[0.12em] transition hover:border-[#00D06C] disabled:cursor-not-allowed disabled:opacity-40") NEXT

    footer(class="mt-8 flex flex-wrap items-center justify-between gap-3 border-t border-neutral-200 pt-4 font-mono text-[9px] tracking-[0.12em] text-neutral-400")
      span SCISS’ BARBER · MEMBER SPACE
      a(href="/profile", class="transition hover:text-[#00D06C]") PROFILE →

  script.
    const walletBalanceLoading = document.getElementById('wallet-balance-loading');
    const walletBalanceDisplay = document.getElementById('wallet-balance');
    const walletBalanceError = document.getElementById('wallet-balance-error');
    const walletTransactionsLoading = document.getElementById('wallet-transactions-loading');
    const walletTransactionsError = document.getElementById('wallet-transactions-error');
    const walletTransactionsEmpty = document.getElementById('wallet-transactions-empty');
    const walletTransactionsList = document.getElementById('wallet-transactions-list');
    const walletTransactionsPagination = document.getElementById('wallet-transactions-pagination');
    const walletTransactionsPrevious = document.getElementById('wallet-transactions-previous');
    const walletTransactionsNext = document.getElementById('wallet-transactions-next');
    const walletTransactionsPage = document.getElementById('wallet-transactions-page');
    const walletRetryButton = document.getElementById('wallet-retry');
    let walletLoadInProgress = false;
    let walletTransactionPage = 1;

    const formatWalletMoney = (value) => {
      const amount = Number(value);
      return Number.isFinite(amount)
        ? new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 2 }).format(amount)
        : 'Amount unavailable';
    };

    const formatWalletDate = (value) => {
      const date = value ? new Date(value) : null;
      return date && !Number.isNaN(date.getTime())
        ? date.toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Kolkata' })
        : 'Date unavailable';
    };

    const createWalletTransactionCard = (transaction) => {
      const card = document.createElement('article');
      card.className = 'rounded-xl border border-neutral-200 p-4';
      const header = document.createElement('div');
      header.className = 'flex flex-wrap items-start justify-between gap-3';
      const type = String(transaction?.type || '').toUpperCase();
      const title = document.createElement('p');
      title.className = 'font-semibold';
      title.textContent = type === 'CREDIT' ? 'Wallet credit' : type === 'DEBIT' ? 'Wallet debit' : 'Wallet transaction';
      const amount = document.createElement('p');
      amount.className = `font-mono text-sm font-bold ${type === 'CREDIT' ? 'text-green-700' : 'text-neutral-900'}`;
      const sign = type === 'CREDIT' ? '+' : type === 'DEBIT' ? '−' : '';
      amount.textContent = `${sign}${formatWalletMoney(transaction?.amount)}`;
      header.append(title, amount);

      const detail = document.createElement('div');
      detail.className = 'mt-3 flex flex-col gap-1 text-xs text-neutral-500 sm:flex-row sm:items-center sm:justify-between';
      const reason = document.createElement('span');
      const reasonNames = { BOOKING_REFUND: 'Booking refund', BOOKING_PAYMENT: 'Booking payment' };
      reason.textContent = reasonNames[String(transaction?.reason || '').toUpperCase()] || String(transaction?.reason || 'Transaction');
      const date = document.createElement('span');
      date.textContent = formatWalletDate(transaction?.createdAt);
      detail.append(reason, date);

      const balance = document.createElement('p');
      balance.className = 'mt-3 border-t border-neutral-100 pt-3 text-xs text-neutral-600';
      balance.textContent = `Balance after: ${formatWalletMoney(transaction?.balanceAfter)}`;
      card.append(header, detail, balance);
      return card;
    };

    async function loadWallet() {
      if (walletLoadInProgress) return;
      walletLoadInProgress = true;
      walletRetryButton.disabled = true;
      walletBalanceDisplay.classList.add('hidden');
      walletBalanceLoading.classList.remove('hidden');
      walletBalanceError.classList.add('hidden');
      walletTransactionsLoading.classList.remove('hidden');
      walletTransactionsError.classList.add('hidden');
      walletTransactionsEmpty.classList.add('hidden');
      walletTransactionsList.classList.add('hidden');
      walletTransactionsPagination.classList.add('hidden');
      walletTransactionsPagination.classList.remove('flex');
      walletTransactionsList.replaceChildren();

      const loadBalance = async () => {
        try {
          const response = await fetch('/balance', { credentials: 'same-origin', headers: { Accept: 'application/json' } });
          const result = await response.json();
          if (!response.ok || result?.success !== true || !Number.isFinite(Number(result.balance))) {
            throw new Error(result?.message || 'Could not load your wallet balance.');
          }
          walletBalanceDisplay.textContent = formatWalletMoney(result.balance);
          walletBalanceDisplay.classList.remove('hidden');
        } catch (error) {
          walletBalanceError.textContent = error.message || 'Could not load your wallet balance.';
          walletBalanceError.classList.remove('hidden');
        } finally {
          walletBalanceLoading.classList.add('hidden');
        }
      };

      const loadTransactions = async () => {
        try {
          const response = await fetch(`/transactions?page=${walletTransactionPage}&limit=10`, { credentials: 'same-origin', headers: { Accept: 'application/json' } });
          const result = await response.json();
          if (!response.ok || result?.success !== true || !Array.isArray(result.transactions) || !result.pagination) {
            throw new Error(result?.message || 'Could not load your wallet transactions.');
          }
          walletTransactionPage = result.pagination.page;
          if (!result.transactions.length) {
            if (result.pagination.total === 0) {
              walletTransactionsEmpty.classList.remove('hidden');
            } else {
              walletTransactionsList.classList.remove('hidden');
            }
            return;
          }
          result.transactions.forEach((transaction) => walletTransactionsList.appendChild(createWalletTransactionCard(transaction)));
          walletTransactionsList.classList.remove('hidden');
          walletTransactionsPage.textContent = `PAGE ${result.pagination.page} OF ${Math.max(result.pagination.totalPages, 1)} · ${result.pagination.total} TRANSACTIONS`;
          walletTransactionsPrevious.disabled = result.pagination.page <= 1;
          walletTransactionsNext.disabled = result.pagination.page >= result.pagination.totalPages;
          walletTransactionsPagination.classList.add('flex');
          walletTransactionsPagination.classList.remove('hidden');
        } catch (error) {
          walletTransactionsError.textContent = error.message || 'Could not load your wallet transactions.';
          walletTransactionsError.classList.remove('hidden');
        } finally {
          walletTransactionsLoading.classList.add('hidden');
        }
      };

      try {
        await Promise.all([loadBalance(), loadTransactions()]);
      } finally {
        walletLoadInProgress = false;
        walletRetryButton.disabled = false;
      }
    }

    walletRetryButton.addEventListener('click', loadWallet);
    walletTransactionsPrevious.addEventListener('click', () => {
      if (walletLoadInProgress || walletTransactionPage <= 1) return;
      walletTransactionPage -= 1;
      loadWallet();
    });
    walletTransactionsNext.addEventListener('click', () => {
      if (walletLoadInProgress) return;
      walletTransactionPage += 1;
      loadWallet();
    });
    loadWallet();
