extends ../layouts/minimal.pug

block content
  if !user
    div#login-required-modal(
      class="fixed inset-0 z-50 flex items-center justify-center p-4"
      style="background-color: rgba(0,0,0,0.70); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);"
      role="dialog"
      aria-modal="true"
      aria-labelledby="login-required-title"
    )
      div(class="w-full max-w-md rounded-2xl border border-white/15 p-8 text-white shadow-2xl sm:p-10", style="background-color: #080808;")
        p(class="mb-8 font-mono text-[10px] tracking-[0.3em]", style="color: #00D06C;") SCISS' BARBER · KOZHIKODE

        p(class="mb-3 font-mono text-[10px] tracking-[0.2em] text-neutral-400") YOUR NEXT VISIT STARTS HERE
        h2#login-required-title(class="mb-4 text-4xl font-bold tracking-tight text-white") Please login first.

        p(class="mb-9 text-sm leading-relaxed text-neutral-400") Sign in to your account to book your appointment. We'll have the chair ready.

        div(class="flex flex-col-reverse justify-between gap-3 sm:flex-row sm:items-center")
          button#login-required-cancel(type="button", class="rounded-full border border-white/20 bg-transparent px-6 py-3 font-mono text-xs tracking-widest text-white transition hover:bg-white/10") CANCEL
          div(class="flex flex-col gap-3 sm:flex-row sm:items-center")
            a(href="/signup?returnTo=%2Fbooking", class="rounded-full border border-white/20 px-6 py-3 text-center font-mono text-xs font-bold tracking-widest text-white transition hover:bg-white/10") CREATE ACCOUNT
            a(href="/login?returnTo=%2Fbooking", class="rounded-full px-7 py-3 text-center font-mono text-xs font-bold tracking-widest text-black transition", style="background-color: #00D06C;") LOGIN →
  -
    const bookingServiceGroups = typeof serviceGroups !== 'undefined' && Array.isArray(serviceGroups) ? serviceGroups : [];

  div(class="mx-auto flex w-full max-w-6xl flex-1 flex-col py-8 sm:py-12")
    a(href="/", class="mb-8 w-fit font-mono text-xs font-bold tracking-[0.15em] text-neutral-500 transition hover:text-[#00D06C]") ← BACK HOME

    div(class="mb-10 grid gap-6 border-b border-neutral-200 pb-8 sm:mb-12 sm:grid-cols-[1fr_auto] sm:items-end")
      div
        p(class="mb-4 font-mono text-[10px] tracking-[0.3em] text-neutral-400") SCISS’ BARBER · KOZHIKODE
        h1(class="text-[clamp(3rem,9vw,6.5rem)] font-bold leading-[0.88] tracking-[-0.08em]") BOOK YOUR VISIT.
      p(class="max-w-xs text-sm leading-relaxed text-neutral-500") Choose a service and a time that works for you. We’ll have the chair ready.

    form#booking-form(class="grid gap-10 lg:grid-cols-[1fr_0.72fr]")
      div(class="space-y-10")
        fieldset
          legend(class="mb-4 font-mono text-[11px] font-bold tracking-[0.2em]") 01 / CHOOSE YOUR SERVICE
          p(class="mb-4 text-xs text-neutral-500") Choose one or more services. Select a category and tap each service to add or remove it.
          div#service-categories(class="flex flex-wrap gap-2")
            each group, index in bookingServiceGroups
              button(type="button", data-service-category=group.title, aria-pressed=index === 0, class=index === 0 ? "booking-category-chip is-active" : "booking-category-chip")= group.title
          p#selected-services-status(class="mt-4 rounded-xl bg-neutral-100 px-4 py-3 text-xs font-medium text-neutral-600", role="status", aria-live="polite") No services selected.
          div#service-options(class="mt-4 grid gap-3 sm:grid-cols-2")
            if bookingServiceGroups.length
              p#service-prompt(class="rounded-2xl border border-dashed border-neutral-300 px-5 py-6 text-sm text-neutral-400 sm:col-span-2") Choose a service category to view the menu.
            else
              p#service-prompt(class="rounded-2xl border border-dashed border-neutral-300 px-5 py-6 text-sm text-neutral-400 sm:col-span-2") Services are currently unavailable.
          //- Worked by Codex: serialize all chosen services as a comma-separated ID list for availability lookup.
          input#booking-service(type="hidden", name="serviceIds")
          input#booking-time(type="hidden", name="time")
          input#booking-end-time(type="hidden", name="endTime")
          a(href="/services", class="mt-3 inline-flex text-xs font-semibold text-neutral-500 transition hover:text-[#00D06C]") View the full services & price list →

        fieldset
          legend(class="mb-4 font-mono text-[11px] font-bold tracking-[0.2em]") 02 / CHOOSE A DATE & TIME
          p(class="mb-3 text-xs text-neutral-500") Choose a day
          div#date-choices(class="grid grid-cols-3 gap-2 sm:grid-cols-7")
          input#booking-date(type="hidden", name="date")
          div(class="mt-6")
            p(class="mb-3 text-xs text-neutral-500") Choose a preferred time
            div#time-choices(class="grid grid-cols-2 gap-2 sm:grid-cols-3", aria-live="polite")
              p#time-slots-state(class="col-span-full rounded-xl border border-dashed border-neutral-300 px-4 py-4 text-sm text-neutral-400", role="status") Choose a service and date to see available times.

      aside(class="h-fit rounded-2xl bg-neutral-950 p-6 text-white sm:p-8")
        p(class="font-mono text-[10px] tracking-[0.25em] text-neutral-400") YOUR APPOINTMENT
        h2(class="mb-8 mt-3 text-2xl font-bold tracking-tight") Ready when you are.
        p(class="mb-8 text-sm leading-relaxed text-neutral-400") Review your service, date, and time before you continue.
        div(class="mb-6 border-y border-white/15 py-5")
          div(class="flex items-start justify-between gap-4")
            div
              p(class="font-mono text-[9px] tracking-[0.16em] text-neutral-400") SELECTED SERVICE
              p#summary-service(class="mt-2 text-sm font-semibold") Choose a service
              p#summary-duration(class="mt-1 text-xs text-neutral-400") Choose services to see total duration
            div(class="text-right")
              p(class="font-mono text-[9px] tracking-[0.16em] text-neutral-400") PRICE
              p#summary-price(class="mt-2 text-sm font-bold text-[#00D06C]") —
          p#summary-datetime(class="mt-4 text-xs text-neutral-400") Select your date and time
        button(type="submit", class="flex h-14 w-full items-center justify-between rounded-full bg-[#00D06C] px-6 font-mono text-xs font-bold tracking-[0.12em] text-black transition hover:bg-white")
          span REVIEW APPOINTMENT
          span(class="text-lg") →
        p#booking-status.mt-5.text-sm.leading-relaxed.text-neutral-300(role="status", aria-live="polite")

  div#booking-confirmation(
    class="fixed inset-0 z-50 hidden items-center justify-center p-4"
    style="background-color: rgba(0,0,0,0.70); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);"
    role="dialog"
    aria-modal="true"
    aria-labelledby="booking-confirmation-title"
  )
    div(class="w-full max-w-md rounded-2xl border border-white/15 p-8 text-white shadow-2xl sm:p-10", style="background-color: #080808;")
      p(class="mb-2 font-mono text-[10px] tracking-[0.3em]", style="color: #00D06C;") SCISS' BARBER · KOZHIKODE
      h2#booking-confirmation-title(class="mb-6 text-2xl font-bold tracking-tight text-white") Review your booking
      div(class="mb-6 space-y-3 rounded-xl border border-white/10 p-4 text-sm")
        div(class="flex items-center justify-between gap-4")
          span(class="font-mono text-[9px] tracking-[0.14em] text-neutral-400") SERVICE
          span#confirm-service(class="text-right font-semibold text-white") —
        div(class="flex items-center justify-between gap-4")
          span(class="font-mono text-[9px] tracking-[0.14em] text-neutral-400") DATE
          span#confirm-date(class="text-right font-semibold text-white") —
        div(class="flex items-center justify-between gap-4")
          span(class="font-mono text-[9px] tracking-[0.14em] text-neutral-400") TIME
          span#confirm-time(class="text-right font-semibold text-white") —
        div(class="flex items-center justify-between gap-4")
          span(class="font-mono text-[9px] tracking-[0.14em] text-neutral-400") TOTAL DURATION
          span#confirm-duration(class="text-right font-semibold text-white") —
        div(class="flex items-center justify-between gap-4")
          span(class="font-mono text-[9px] tracking-[0.14em] text-neutral-400") PRICE
          span#confirm-price(class="text-right font-bold", style="color: #00D06C;") —
        div#confirm-advance-container(class="hidden items-center justify-between gap-4 border-t border-white/10 pt-3")
          span(class="font-mono text-[9px] tracking-[0.14em] text-neutral-400") ADVANCE DUE NOW
          span#confirm-advance(class="text-right font-mono text-xs font-bold", style="color: #00D06C;") —
      fieldset(class="mb-5 space-y-2", aria-labelledby="payment-method-heading")
        legend#payment-method-heading(class="mb-2 font-mono text-[9px] font-bold tracking-[0.16em] text-neutral-400") PAYMENT METHOD
        label(class="flex cursor-pointer items-start gap-3 rounded-xl border border-white/15 p-3 transition hover:border-[#00D06C]")
          input#payment-method-razorpay(type="radio", name="booking-payment-method", value="RAZORPAY", checked, class="mt-1", style="accent-color:#00D06C")
          span(class="min-w-0")
            span(class="block text-sm font-semibold text-white") Razorpay
            span(class="mt-1 block text-xs leading-relaxed text-neutral-400") Pay securely by card, UPI, or other supported methods.
        label(class="flex cursor-pointer items-start gap-3 rounded-xl border border-white/15 p-3 transition hover:border-[#00D06C]")
          input#payment-method-wallet(type="radio", name="booking-payment-method", value="WALLET", class="mt-1", style="accent-color:#00D06C")
          span(class="min-w-0")
            span(class="block text-sm font-semibold text-white") Wallet
            span(class="mt-1 block text-xs leading-relaxed text-neutral-400") Use your Sciss Barber wallet balance.
      div#wallet-payment-panel(class="mb-5 hidden rounded-xl border border-white/15 bg-white/5 p-4")
        p(class="font-mono text-[9px] tracking-[0.14em] text-neutral-400") AVAILABLE WALLET BALANCE
        p#wallet-balance-value(class="mt-1 text-lg font-bold text-[#00D06C]", role="status", aria-live="polite") Checking wallet balance…
        p#wallet-advance-value(class="mt-3 text-xs text-neutral-300") Booking advance: not calculated yet
        p#wallet-difference(class="mt-2 hidden text-xs font-semibold text-amber-300", role="status", aria-live="polite")
        p#wallet-payment-status(class="mt-3 text-xs leading-relaxed text-neutral-300", role="status", aria-live="polite") Your wallet will be charged the booking advance after you confirm.
      p#confirm-status(class="mb-5 hidden rounded-lg border p-3 text-sm leading-relaxed", role="status", aria-live="polite")
      div(class="flex gap-3")
        button#confirm-cancel(type="button", class="flex-1 cursor-pointer rounded-full border border-white/20 bg-transparent py-3 font-mono text-xs tracking-widest text-white transition hover:bg-white/10") GO BACK
        button#confirm-submit(type="button", class="flex-1 cursor-pointer rounded-full py-3 font-mono text-xs font-bold tracking-widest text-black transition", style="background-color: #00D06C;") CONFIRM BOOKING

  style.
    #booking-confirmation { display: none; }
    #booking-confirmation.is-open { display: flex; }
    #booking-confirmation > div {
      transform: translateY(-10px) scale(0.97);
      opacity: 0;
      transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1), opacity 200ms ease;
    }
    #booking-confirmation.is-open > div {
      transform: translateY(0) scale(1);
      opacity: 1;
    }

  script(src="https://checkout.razorpay.com/v1/checkout.js")
  script#booking-service-data(type="application/json")!= JSON.stringify(bookingServiceGroups).replace(/</g, '\\u003c')
  script#booking-shop-data(type="application/json")!= JSON.stringify({ weeklyOff: weeklyOff || '' }).replace(/</g, '\\u003c')
  script#booking-user-data(type="application/json")!= JSON.stringify(user ? { name: user.name || '', email: user.email || '', phone: user.phone || '' } : null).replace(/</g, '\\u003c')

  script.
    const bookingForm = document.getElementById('booking-form');
    const bookingDate = document.getElementById('booking-date');
    const bookingService = document.getElementById('booking-service');
    const bookingTime = document.getElementById('booking-time');
    const bookingEndTime = document.getElementById('booking-end-time');
    const serviceGroups = JSON.parse(document.getElementById('booking-service-data').textContent);
    const shopRules = JSON.parse(document.getElementById('booking-shop-data').textContent);
    const userData = JSON.parse(document.getElementById('booking-user-data')?.textContent || 'null');
    const serviceCategories = document.getElementById('service-categories');
    const serviceOptions = document.getElementById('service-options');
    const selectedServicesStatus = document.getElementById('selected-services-status');
    const dateChoices = document.getElementById('date-choices');
    const timeChoices = document.getElementById('time-choices');
    const summaryService = document.getElementById('summary-service');
    const summaryDuration = document.getElementById('summary-duration');
    const summaryPrice = document.getElementById('summary-price');
    const summaryDateTime = document.getElementById('summary-datetime');
    const confirmAdvanceContainer = document.getElementById('confirm-advance-container');
    const confirmAdvance = document.getElementById('confirm-advance');
    const confirmAdvanceLabel = confirmAdvanceContainer?.querySelector('span');
    const walletPaymentPanel = document.getElementById('wallet-payment-panel');
    const walletBalanceValue = document.getElementById('wallet-balance-value');
    const walletAdvanceValue = document.getElementById('wallet-advance-value');
    const walletDifference = document.getElementById('wallet-difference');
    const walletPaymentStatus = document.getElementById('wallet-payment-status');
    const razorpayMethodInput = document.getElementById('payment-method-razorpay');
    const walletMethodInput = document.getElementById('payment-method-wallet');
    const confirmStatus = document.getElementById('confirm-status');
    const confirmCancel = document.getElementById('confirm-cancel');
    const confirmSubmit = document.getElementById('confirm-submit');
    const today = new Date();
    const weeklyOffDay = String(shopRules.weeklyOff || '').toUpperCase();

    function isShopClosed(date) {
      return Boolean(weeklyOffDay) && date.toLocaleDateString('en-US', { weekday: 'long' }).toUpperCase() === weeklyOffDay;
    }

    let activeBooking = null;
    let activeOrder = null;
    let pendingVerification = null;
    let paymentFailureMessage = '';
    let paymentFailureSaving = false;
    let currentSelectionKey = '';
    let selectedPaymentMethod = 'RAZORPAY';
    let walletBalance = null;
    let walletBalanceError = '';
    let walletBalanceLoading = false;
    let walletBalanceRequest = null;
    let walletPaymentBlocked = false;
    // Worked by Codex: preserve service choices while customers switch between categories.
    const selectedServices = new Map();

    function syncSelectedServices() {
      const selected = Array.from(selectedServices.values());
      const durations = selected.map((service) => {
        const duration = Number(service.duration);
        return Number.isFinite(duration) && duration > 0 ? duration : null;
      });
      const durationIsKnown = selected.length > 0 && durations.every((duration) => duration !== null);
      const combinedDuration = durationIsKnown ? durations.reduce((total, duration) => total + duration, 0) : null;
      bookingService.value = selected.map((service) => service.id).join(',');
      bookingService.dataset.name = selected.map((service) => service.name).join(' + ');
      bookingService.dataset.price = selected.some((service) => service.price === null || service.price === undefined || service.price === '' || !Number.isFinite(Number(service.price)))
        ? 'Ask in shop'
        : String(selected.reduce((total, service) => total + Number(service.price), 0));
      bookingService.dataset.duration = combinedDuration === null ? '' : String(combinedDuration);
      bookingService.dataset.durationLabel = combinedDuration === null ? 'Duration unavailable' : `${combinedDuration} min total`;
      selectedServicesStatus.textContent = selected.length
        ? `${selected.length} service${selected.length === 1 ? '' : 's'} selected: ${selected.map((service) => service.name).join(', ')} · ${bookingService.dataset.durationLabel}`
        : 'No services selected.';
      updateBookingSummary();
    }

    function getSelectionKey() {
      return `${bookingService.value}|${bookingDate.value}|${bookingTime.value}`;
    }

    function resetBookingState() {
      activeBooking = null;
      activeOrder = null;
      pendingVerification = null;
      paymentFailureMessage = '';
      currentSelectionKey = '';
      if (confirmAdvanceContainer) {
        confirmAdvanceContainer.classList.add('hidden');
        confirmAdvanceContainer.classList.remove('flex');
      }
      if (confirmAdvance) {
        confirmAdvance.textContent = '—';
      }
      if (confirmAdvanceLabel) confirmAdvanceLabel.textContent = 'ADVANCE DUE NOW';
      walletPaymentBlocked = false;
      walletAdvanceValue.textContent = 'Booking advance: not calculated yet';
      walletDifference.classList.add('hidden');
      walletDifference.classList.remove('text-[#00D06C]');
      walletDifference.classList.add('text-amber-300');
      walletPaymentStatus.textContent = walletBalance === null
        ? (walletBalanceError || 'Wallet balance will load here. The booking advance is shown after the booking is created.')
        : 'Wallet balance is available. The booking advance is shown after the booking is created.';
      if (confirmStatus) {
        confirmStatus.textContent = '';
        confirmStatus.classList.add('hidden');
        confirmStatus.classList.remove('text-[#00D06C]', 'text-neutral-300', 'text-neutral-400', 'text-red-400', 'text-red-300', 'border-red-500/40', 'bg-red-500/10');
        confirmStatus.setAttribute('role', 'status');
        confirmStatus.setAttribute('aria-live', 'polite');
      }
      if (confirmSubmit) {
        confirmSubmit.disabled = false;
        confirmSubmit.textContent = selectedPaymentMethod === 'WALLET' ? 'CONTINUE WITH WALLET' : 'CONFIRM BOOKING';
      }
      if (confirmCancel) {
        confirmCancel.textContent = 'GO BACK';
      }
    }

    function formatServicePrice(price) {
      if (price === null || price === undefined || price === '') return 'Price unavailable';
      const numericPrice = Number(price);
      return Number.isFinite(numericPrice)
        ? `₹${numericPrice.toLocaleString('en-IN')}`
        : String(price);
    }

    function formatServiceDuration(duration) {
      const minutes = Number(duration);
      return Number.isFinite(minutes) && minutes > 0 ? `${minutes} min` : 'Duration unavailable';
    }

    function formatWalletAmount(amount) {
      const numericAmount = Number(amount);
      return Number.isFinite(numericAmount)
        ? new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 2 }).format(numericAmount)
        : 'Amount unavailable';
    }

    function loadWalletBalance() {
      if (!userData) {
        walletBalanceError = 'Sign in to view your wallet balance.';
        walletBalanceValue.textContent = walletBalanceError;
        return Promise.resolve(null);
      }
      if (walletBalanceRequest) return walletBalanceRequest;

      walletBalanceLoading = true;
      walletBalanceError = '';
      walletBalanceValue.textContent = 'Loading wallet balance…';
      walletBalanceRequest = (async () => {
        try {
          const response = await fetch('/balance', {
            credentials: 'same-origin',
            headers: { Accept: 'application/json' }
          });
          const result = await response.json();
          if (!response.ok || result?.success !== true || !Number.isFinite(Number(result.balance))) {
            throw new Error(result?.message || 'Could not load your wallet balance.');
          }
          walletBalance = Number(result.balance);
          walletBalanceValue.textContent = formatWalletAmount(walletBalance);
          return walletBalance;
        } catch (error) {
          walletBalance = null;
          walletBalanceError = error.message || 'Could not load your wallet balance.';
          walletBalanceValue.textContent = walletBalanceError;
          return null;
        } finally {
          walletBalanceLoading = false;
          walletBalanceRequest = null;
          if (selectedPaymentMethod === 'WALLET' && !activeBooking && !walletPaymentBlocked) {
            walletPaymentStatus.textContent = walletBalance === null
              ? (walletBalanceError || 'Wallet balance is unavailable. Choose Razorpay to continue.')
              : 'Wallet balance is available. The booking advance is shown after the booking is created.';
          }
        }
      })();
      return walletBalanceRequest;
    }

    function showWalletAdvance(amount) {
      if (!Number.isFinite(Number(amount)) || Number(amount) <= 0) return;
      const formattedAmount = formatWalletAmount(amount);
      walletAdvanceValue.textContent = `Booking advance: ${formattedAmount}`;
      confirmAdvance.textContent = formattedAmount;
      if (confirmAdvanceLabel) confirmAdvanceLabel.textContent = 'ADVANCE DUE NOW';
      confirmAdvanceContainer.classList.remove('hidden');
      confirmAdvanceContainer.classList.add('flex');
    }

    function evaluateWalletPayment(paymentInProgress = false) {
      walletDifference.classList.remove('text-[#00D06C]');
      walletDifference.classList.add('text-amber-300');
      const advanceAmount = Number(activeBooking?.advanceAmount);
      if (!Number.isFinite(advanceAmount) || advanceAmount <= 0) {
        walletPaymentStatus.textContent = 'The booking advance amount is unavailable, so wallet eligibility cannot be calculated.';
        walletDifference.classList.add('hidden');
        walletPaymentBlocked = true;
        confirmSubmit.disabled = true;
        confirmSubmit.textContent = 'WALLET UNAVAILABLE';
        return;
      }
      showWalletAdvance(advanceAmount);
      if (walletBalance === null) {
        walletPaymentStatus.textContent = walletBalanceError || 'Wallet balance is unavailable. Choose Razorpay to continue.';
        walletDifference.classList.add('hidden');
        walletPaymentBlocked = true;
        confirmSubmit.disabled = true;
        confirmSubmit.textContent = 'WALLET UNAVAILABLE';
        return;
      }

      const difference = advanceAmount - walletBalance;
      if (difference > 0) {
        walletDifference.textContent = `You need ${formatWalletAmount(difference)} more to cover the ${formatWalletAmount(advanceAmount)} advance.`;
        walletDifference.classList.remove('hidden');
        walletPaymentStatus.textContent = 'Your wallet balance is insufficient. Choose Razorpay or add funds before paying with Wallet.';
        walletPaymentBlocked = true;
        confirmSubmit.disabled = true;
        confirmSubmit.textContent = 'INSUFFICIENT BALANCE';
      } else {
        walletDifference.textContent = `Your balance covers the ${formatWalletAmount(advanceAmount)} advance.`;
        walletDifference.classList.remove('hidden');
        walletDifference.classList.remove('text-amber-300');
        walletDifference.classList.add('text-[#00D06C]');
        walletPaymentStatus.textContent = 'Your balance covers the advance. Confirm to pay from your wallet.';
        walletPaymentBlocked = false;
        confirmSubmit.disabled = paymentInProgress;
        confirmSubmit.textContent = paymentInProgress ? 'PAYING WITH WALLET…' : 'PAY WITH WALLET';
      }
    }

    function selectPaymentMethod(method) {
      if (confirmSubmit.disabled && !walletPaymentBlocked) {
        if (razorpayMethodInput) razorpayMethodInput.checked = selectedPaymentMethod === 'RAZORPAY';
        if (walletMethodInput) walletMethodInput.checked = selectedPaymentMethod === 'WALLET';
        return;
      }
      selectedPaymentMethod = method;
      const isWallet = method === 'WALLET';
      walletPaymentPanel.classList.toggle('hidden', !isWallet);
      if (isWallet) {
        walletPaymentBlocked = false;
        walletDifference.classList.add('hidden');
        if (activeBooking) {
          evaluateWalletPayment();
        } else {
          confirmSubmit.disabled = false;
          confirmSubmit.textContent = 'CONTINUE WITH WALLET';
          walletPaymentStatus.textContent = walletBalance === null
            ? (walletBalanceError || 'Wallet balance will load here. The booking advance is shown after the booking is created.')
            : 'Wallet balance is available. The booking advance is shown after the booking is created.';
        }
        if (walletBalance === null && !walletBalanceLoading && userData) loadWalletBalance();
      } else {
        walletPaymentBlocked = false;
        walletDifference.classList.add('hidden');
        walletDifference.classList.remove('text-[#00D06C]');
        walletDifference.classList.add('text-amber-300');
        confirmSubmit.disabled = false;
        confirmSubmit.textContent = activeOrder ? 'RETRY PAYMENT' : activeBooking ? 'RETRY PAYMENT' : 'CONFIRM BOOKING';
        if (!confirmStatus.classList.contains('hidden') && (confirmStatus.textContent.includes('Wallet') || confirmStatus.classList.contains('border-red-500/40'))) {
          confirmStatus.textContent = '';
          confirmStatus.classList.add('hidden');
          confirmStatus.classList.remove('text-red-300', 'border-red-500/40', 'bg-red-500/10');
          confirmStatus.classList.add('text-neutral-300');
          confirmStatus.setAttribute('role', 'status');
          confirmStatus.setAttribute('aria-live', 'polite');
        }
      }
    }

    razorpayMethodInput?.addEventListener('change', () => selectPaymentMethod('RAZORPAY'));
    walletMethodInput?.addEventListener('change', () => selectPaymentMethod('WALLET'));

    function updateBookingSummary() {
      const selectedName = bookingService.dataset.name || '';
      const selectedPrice = bookingService.dataset.price || '';
      const selectedDate = bookingDate.value;
      const selectedTime = bookingTime.dataset.label || bookingTime.value;
      const selectedEndTime = bookingEndTime.dataset.label || bookingEndTime.value;
      const prettyDate = selectedDate
        ? new Date(selectedDate + 'T00:00:00').toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })
        : '';
      summaryService.textContent = selectedName || 'Choose a service';
      summaryDuration.textContent = bookingService.value
        ? (bookingService.dataset.durationLabel || 'Duration unavailable')
        : 'Choose services to see total duration';
      summaryPrice.textContent = !selectedPrice
        ? '—'
        : selectedPrice === 'Ask in shop'
          ? 'Confirm in shop'
          : formatServicePrice(selectedPrice);
      summaryDateTime.textContent = prettyDate || selectedTime
        ? (prettyDate || 'Choose a date') + (selectedTime ? ' · ' + selectedTime : '') + (selectedEndTime ? ' – ' + selectedEndTime : '')
        : 'Select your date and time';
    }

    function setServiceCategory(categoryName) {
      serviceCategories.querySelectorAll('[data-service-category]').forEach((button) => {
        const isSelected = button.dataset.serviceCategory === categoryName;
        button.classList.toggle('is-active', isSelected);
        button.setAttribute('aria-pressed', String(isSelected));
      });

      const group = serviceGroups.find((item) => item.title === categoryName);
      serviceOptions.replaceChildren();
      bookingTime.value = '';
      bookingTime.dataset.label = '';
      bookingEndTime.value = '';
      bookingEndTime.dataset.label = '';
      updateBookingSummary();
      loadAvailableTimeSlots();
      resetBookingState();

      if (!group || !Array.isArray(group.items) || group.items.length === 0) {
        const prompt = document.createElement('p');
        prompt.className = 'rounded-2xl border border-dashed border-neutral-300 px-5 py-6 text-sm text-neutral-400 sm:col-span-2';
        prompt.textContent = group ? 'No services are available in this category.' : 'Choose a service category to view the menu.';
        serviceOptions.appendChild(prompt);
        return;
      }

      group.items.forEach((service) => {
        const option = document.createElement('button');
        option.type = 'button';
        option.className = 'booking-service-card';
        option.dataset.serviceId = service._id || '';
        option.dataset.serviceName = service.name || '';
        option.dataset.price = service.price ?? '';
        option.dataset.duration = service.duration ?? '';
        option.setAttribute('aria-pressed', String(selectedServices.has(option.dataset.serviceId)));
        if (selectedServices.has(option.dataset.serviceId)) option.classList.add('is-selected');

        const serviceName = document.createElement('span');
        serviceName.className = 'text-sm font-semibold';
        serviceName.textContent = service.name || 'Unnamed service';

        const serviceDuration = document.createElement('span');
        serviceDuration.className = 'mt-1 block text-xs text-neutral-500';
        serviceDuration.textContent = formatServiceDuration(service.duration);

        const serviceDetails = document.createElement('span');
        serviceDetails.className = 'min-w-0 flex-1';
        serviceDetails.append(serviceName, serviceDuration);

        const servicePrice = document.createElement('span');
        servicePrice.className = 'font-mono text-xs font-bold';
        servicePrice.textContent = formatServicePrice(service.price);

        const selectionState = document.createElement('span');
        selectionState.className = 'booking-service-selection-state';
        selectionState.textContent = selectedServices.has(option.dataset.serviceId) ? 'ADDED ✓' : 'ADD +';

        option.append(serviceDetails, servicePrice, selectionState);
        option.addEventListener('click', () => {
          if (selectedServices.has(option.dataset.serviceId)) {
            selectedServices.delete(option.dataset.serviceId);
            option.classList.remove('is-selected');
            option.setAttribute('aria-pressed', 'false');
            selectionState.textContent = 'ADD +';
          } else {
            selectedServices.set(option.dataset.serviceId, {
              id: option.dataset.serviceId,
              name: option.dataset.serviceName,
              price: option.dataset.price,
              duration: option.dataset.duration
            });
            option.classList.add('is-selected');
            option.setAttribute('aria-pressed', 'true');
            selectionState.textContent = 'ADDED ✓';
          }
          syncSelectedServices();
          bookingTime.value = '';
          bookingTime.dataset.label = '';
          bookingEndTime.value = '';
          bookingEndTime.dataset.label = '';
          updateBookingSummary();
          loadAvailableTimeSlots();
        });

        serviceOptions.appendChild(option);
      });
    }

    serviceCategories.addEventListener('click', (event) => {
      const categoryButton = event.target.closest('[data-service-category]');
      if (categoryButton) setServiceCategory(categoryButton.dataset.serviceCategory);
    });

    let timeSlotRequestId = 0;

    function showTimeSlotState(state, message) {
      const stateMessage = document.createElement('p');
      const stateColor = state === 'error' ? 'text-red-600' : 'text-neutral-400';
      stateMessage.className = `col-span-full rounded-xl border border-dashed border-neutral-300 px-4 py-4 text-sm ${stateColor}`;
      stateMessage.setAttribute('role', state === 'error' ? 'alert' : 'status');
      stateMessage.textContent = message;
      timeChoices.replaceChildren(stateMessage);
    }

    async function requestAvailableTimeSlots(serviceId, dateValue) {
      const response = await fetch(
        `/api/bookings/available-slots?serviceIds=${encodeURIComponent(serviceId)}&date=${encodeURIComponent(dateValue)}`,
        {
          method: 'GET',
          headers: { 'Accept': 'application/json' }
        }
      );

      let data;
      try {
        data = await response.json();
      } catch (error) {
        throw new Error('The availability response could not be read.');
      }

      if (!response.ok || !data.success) {
        throw new Error(data.message || 'Failed to fetch available time slots.');
      }

      return data.slots;
    }

    function formatAvailableTime(value) {
      const timeValue = String(value);
      if (/^\d{1,2}:\d{2}$/.test(timeValue)) {
        const [hour, minute] = timeValue.split(':').map(Number);
        return new Date(2000, 0, 1, hour, minute).toLocaleTimeString('en-IN', { hour: 'numeric', minute: '2-digit' });
      }
      const dateValue = new Date(timeValue);
      return Number.isNaN(dateValue.getTime())
        ? timeValue
        : dateValue.toLocaleTimeString('en-IN', { hour: 'numeric', minute: '2-digit' });
    }

    async function loadAvailableTimeSlots() {
      const requestId = ++timeSlotRequestId;
      bookingTime.value = '';
      bookingTime.dataset.label = '';
      bookingEndTime.value = '';
      bookingEndTime.dataset.label = '';

      if (!bookingService.value || !bookingDate.value) {
        showTimeSlotState('empty', 'Choose a service and date to see available times.');
        updateBookingSummary();
        return;
      }

      showTimeSlotState('loading', 'Checking available times…');
      try {
        const slots = await requestAvailableTimeSlots(bookingService.value, bookingDate.value);
        if (requestId !== timeSlotRequestId) return;
        if (!Array.isArray(slots)) throw new Error('The availability response is not a list of time slots.');
        if (slots.length === 0) {
        showTimeSlotState('empty', 'No available times for these services and date.');
          return;
        }

        const slotButtons = slots.map((slot) => {
          const startTime = slot?.startTime;
          const endTime = slot?.endTime;
          if (!startTime || !endTime) return null;
          const slotButton = document.createElement('button');
          slotButton.type = 'button';
          slotButton.dataset.timeSlot = String(startTime);
          slotButton.dataset.timeEnd = String(endTime);
          slotButton.dataset.timeLabel = formatAvailableTime(startTime);
          slotButton.dataset.timeEndLabel = formatAvailableTime(endTime);
          slotButton.className = 'booking-time-chip';
          slotButton.textContent = slotButton.dataset.timeLabel;
          return slotButton;
        }).filter(Boolean);

        if (slotButtons.length === 0) {
          showTimeSlotState('empty', 'No available times for these services and date.');
          return;
        }
        timeChoices.replaceChildren(...slotButtons);
      } catch (error) {
        if (requestId === timeSlotRequestId) {
          showTimeSlotState('error', `Unable to load available times. ${error.message || 'Please try again.'}`);
        }
      }
    }

    if (serviceGroups.length) setServiceCategory(serviceGroups[0].title);

    function setDate(dateValue, selectedButton) {
      bookingDate.value = dateValue;
      dateChoices.querySelectorAll('.booking-date-chip').forEach((button) => button.classList.remove('is-selected'));
      if (selectedButton) selectedButton.classList.add('is-selected');
      bookingTime.value = '';
      bookingTime.dataset.label = '';
      bookingEndTime.value = '';
      bookingEndTime.dataset.label = '';
      updateBookingSummary();
      loadAvailableTimeSlots();
      resetBookingState();
    }

    for (let offset = 0; offset < 7; offset += 1) {
      const date = new Date(today.getFullYear(), today.getMonth(), today.getDate() + offset);
      const isoDate = date.getFullYear() + '-' + String(date.getMonth() + 1).padStart(2, '0') + '-' + String(date.getDate()).padStart(2, '0');
      const dayButton = document.createElement('button');
      dayButton.type = 'button';
      dayButton.className = 'booking-date-chip';
      dayButton.dataset.date = isoDate;
      if (isShopClosed(date)) {
        dayButton.classList.add('is-closed');
        dayButton.title = 'Shop closed';
        dayButton.setAttribute('aria-label', `${date.toLocaleDateString('en-IN', { weekday: 'long', day: 'numeric', month: 'long' })}, shop closed`);
      }
      const dayName = document.createElement('span');
      dayName.className = 'font-mono text-[9px] tracking-[0.08em]';
      dayName.textContent = offset === 0 ? 'TODAY' : date.toLocaleDateString('en-IN', { weekday: 'short' }).toUpperCase();
      const dayNumber = document.createElement('span');
      dayNumber.className = 'text-xl font-bold';
      dayNumber.textContent = String(date.getDate());
      const monthName = document.createElement('span');
      monthName.className = 'font-mono text-[8px] tracking-[0.08em]';
      monthName.textContent = date.toLocaleDateString('en-IN', { month: 'short' }).toUpperCase();
      dayButton.append(dayName, dayNumber, monthName);
      dayButton.addEventListener('click', () => setDate(isoDate, dayButton));
      dateChoices.appendChild(dayButton);
    }

    timeChoices.addEventListener('click', (event) => {
      const timeButton = event.target.closest('[data-time-slot]');
      if (!timeButton) return;
      timeChoices.querySelectorAll('[data-time-slot]').forEach((button) => button.classList.remove('is-selected'));
      timeButton.classList.add('is-selected');
      bookingTime.value = timeButton.dataset.timeSlot;
      bookingTime.dataset.label = timeButton.dataset.timeLabel || timeButton.dataset.timeSlot;
      bookingEndTime.value = timeButton.dataset.timeEnd;
      bookingEndTime.dataset.label = timeButton.dataset.timeEndLabel || bookingEndTime.value;
      updateBookingSummary();
      resetBookingState();
    });

    bookingForm.addEventListener('submit', (event) => {
      event.preventDefault();
      const status = document.getElementById('booking-status');
      if (!bookingService.value) {
        status.textContent = 'Choose a service to continue.';
        return;
      }
      if (!bookingDate.value) {
        status.textContent = 'Choose a date to continue.';
        return;
      }
      if (!bookingTime.value) {
        status.textContent = 'Choose a preferred time to continue.';
        return;
      }
      status.textContent = '';
      openConfirmationModal();
    });

    const bookingConfirmation = document.getElementById('booking-confirmation');
    const confirmService = document.getElementById('confirm-service');
    const confirmDate = document.getElementById('confirm-date');
    const confirmTime = document.getElementById('confirm-time');
    const confirmDuration = document.getElementById('confirm-duration');
    const confirmPrice = document.getElementById('confirm-price');

    function openConfirmationModal() {
      const selectedName = bookingService.dataset.name || '';
      const selectedPrice = bookingService.dataset.price || '';
      const selectedDate = bookingDate.value;

      const newSelectionKey = getSelectionKey();
      if (newSelectionKey !== currentSelectionKey) {
        resetBookingState();
        currentSelectionKey = newSelectionKey;
      }

      // Read the selected time chip directly for the most reliable label
      const selectedTimeChip = timeChoices.querySelector('[data-time-slot].is-selected');
      const startLabel = selectedTimeChip
        ? (selectedTimeChip.dataset.timeLabel || selectedTimeChip.textContent.trim())
        : (bookingTime.dataset.label || formatAvailableTime(bookingTime.value));
      const endLabel = selectedTimeChip && selectedTimeChip.dataset.timeEndLabel
        ? ' \u2013 ' + selectedTimeChip.dataset.timeEndLabel
        : (bookingEndTime.dataset.label ? ' \u2013 ' + bookingEndTime.dataset.label : '');

      const prettyDate = selectedDate
        ? new Date(selectedDate + 'T00:00:00').toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })
        : '\u2014';

      confirmService.textContent = selectedName || '\u2014';
      confirmDate.textContent = prettyDate || '\u2014';
      confirmTime.textContent = startLabel ? startLabel + endLabel : '\u2014';
      confirmDuration.textContent = bookingService.dataset.durationLabel || 'Duration unavailable';
      confirmPrice.textContent = !selectedPrice
        ? '\u2014'
        : selectedPrice === 'Ask in shop'
          ? 'Ask in shop'
          : formatServicePrice(selectedPrice);

      if (activeOrder && activeOrder.amount && confirmAdvanceContainer && confirmAdvance) {
        confirmAdvance.textContent = `₹${(activeOrder.amount / 100).toLocaleString('en-IN')}`;
        confirmAdvanceContainer.classList.remove('hidden');
        confirmAdvanceContainer.classList.add('flex');
      }

      bookingConfirmation.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    function closeConfirmationModal() {
      if (confirmSubmit.textContent.includes('CONFIRMED')) {
        window.location.href = '/profile';
        return;
      }
      bookingConfirmation.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    confirmCancel.addEventListener('click', closeConfirmationModal);

    bookingConfirmation.addEventListener('click', (event) => {
      if (event.target === bookingConfirmation) closeConfirmationModal();
    });

    function loadRazorpaySdk() {
      return new Promise((resolve, reject) => {
        if (typeof window.Razorpay === 'function') {
          return resolve(window.Razorpay);
        }
        const existingScript = document.querySelector('script[src*="checkout.razorpay.com"]');
        if (existingScript) {
          existingScript.addEventListener('load', () => resolve(window.Razorpay));
          existingScript.addEventListener('error', () => reject(new Error('Failed to load Razorpay SDK.')));
          if (typeof window.Razorpay === 'function') {
            return resolve(window.Razorpay);
          }
          return;
        }
        const script = document.createElement('script');
        script.src = 'https://checkout.razorpay.com/v1/checkout.js';
        script.async = true;
        script.onload = () => resolve(window.Razorpay);
        script.onerror = () => reject(new Error('Failed to load Razorpay SDK.'));
        document.head.appendChild(script);
      });
    }

    async function verifyPayment(paymentDetails) {
      confirmSubmit.disabled = true;
      confirmSubmit.textContent = 'VERIFYING...';
      confirmStatus.classList.remove('hidden', 'text-red-400', 'text-red-300', 'border-red-500/40', 'bg-red-500/10', 'text-neutral-400');
      confirmStatus.classList.add('text-neutral-300');
      confirmStatus.setAttribute('role', 'status');
      confirmStatus.setAttribute('aria-live', 'polite');
      confirmStatus.textContent = 'Verifying payment with server...';

      const verifyResponse = await fetch('/api/payments/verify', {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          razorpay_order_id: paymentDetails.razorpay_order_id,
          razorpay_payment_id: paymentDetails.razorpay_payment_id,
          razorpay_signature: paymentDetails.razorpay_signature
        })
      });

      let verifyData;
      try {
        verifyData = await verifyResponse.json();
      } catch (err) {
        throw new Error('Unable to parse verification response.');
      }

      if (!verifyResponse.ok || !verifyData.success) {
        throw new Error(verifyData.message || 'Payment verification failed.');
      }

      pendingVerification = null;
      confirmStatus.classList.remove('hidden', 'text-neutral-300', 'text-red-400', 'text-neutral-400');
      confirmStatus.classList.remove('text-red-300', 'border-red-500/40', 'bg-red-500/10');
      confirmStatus.classList.add('text-[#00D06C]');
      confirmStatus.setAttribute('role', 'status');
      confirmStatus.setAttribute('aria-live', 'polite');
      confirmStatus.textContent = 'Payment verified and booking confirmed successfully!';

      confirmSubmit.textContent = 'BOOKING CONFIRMED ✓';
      confirmSubmit.disabled = true;
      confirmCancel.textContent = 'VIEW PROFILE →';

      setTimeout(() => {
        window.location.href = '/profile';
      }, 2500);
    }

    function openRazorpayCheckout(RazorpayConstructor, order) {
      const options = {
        key: order.keyId,
        amount: order.amount,
        currency: order.currency || 'INR',
        name: "SCISS' BARBER",
        description: `${confirmService.textContent} - Booking Advance`,
        order_id: order.orderId,
        prefill: {
          name: userData?.name || '',
          email: userData?.email || '',
          contact: userData?.phone || ''
        },
        theme: {
          color: '#00D06C'
        },
        modal: {
          ondismiss: function () {
            if (paymentFailureMessage) {
              confirmSubmit.disabled = paymentFailureSaving;
              confirmSubmit.textContent = paymentFailureSaving ? 'UPDATING BOOKING...' : 'RETRY PAYMENT';
              confirmStatus.classList.remove('hidden', 'text-neutral-300', 'text-neutral-400', 'text-[#00D06C]');
              confirmStatus.classList.add('text-red-300', 'border-red-500/40', 'bg-red-500/10');
              confirmStatus.setAttribute('role', 'alert');
              confirmStatus.setAttribute('aria-live', 'assertive');
              confirmStatus.textContent = paymentFailureMessage;
              return;
            }
            confirmSubmit.disabled = false;
            confirmSubmit.textContent = 'PAY NOW';
            confirmStatus.classList.remove('hidden', 'text-red-400', 'text-[#00D06C]');
            confirmStatus.classList.remove('text-red-300', 'border-red-500/40', 'bg-red-500/10');
            confirmStatus.classList.add('text-neutral-400');
            confirmStatus.setAttribute('role', 'status');
            confirmStatus.setAttribute('aria-live', 'polite');
            confirmStatus.textContent = 'Payment window was closed. Click "PAY NOW" to complete payment and confirm your booking.';
          }
        },
        handler: async function (response) {
          pendingVerification = {
            razorpay_order_id: response.razorpay_order_id,
            razorpay_payment_id: response.razorpay_payment_id,
            razorpay_signature: response.razorpay_signature
          };

          try {
            await verifyPayment(pendingVerification);
          } catch (error) {
            confirmStatus.classList.remove('hidden', 'text-neutral-300', 'text-[#00D06C]');
            confirmStatus.classList.add('text-red-400');
            confirmStatus.textContent = error.message || 'Payment verification failed. Please try again or contact support.';
            confirmSubmit.disabled = false;
            confirmSubmit.textContent = 'RETRY VERIFICATION';
          }
        }
      };

      const rzpInstance = new RazorpayConstructor(options);

      rzpInstance.on('payment.failed', function (failureResponse) {
        const errorDesc = failureResponse.error?.description || failureResponse.error?.reason || 'Payment transaction failed.';
        paymentFailureMessage = `Payment failed. Your booking is not confirmed. ${errorDesc} Please retry payment.`;
        confirmStatus.classList.remove('hidden', 'text-neutral-300', 'text-[#00D06C]');
        confirmStatus.classList.add('text-red-300', 'border-red-500/40', 'bg-red-500/10');
        confirmStatus.setAttribute('role', 'alert');
        confirmStatus.setAttribute('aria-live', 'assertive');
        confirmStatus.textContent = paymentFailureMessage;
        confirmSubmit.disabled = false;

        const failureMetadata = failureResponse.error?.metadata || {};
        const orderId = failureMetadata.order_id || activeOrder?.orderId;
        const paymentId = failureMetadata.payment_id;
        if (!orderId || !paymentId) {
          confirmSubmit.textContent = 'RETRY PAYMENT';
          return;
        }

        paymentFailureSaving = true;
        confirmSubmit.disabled = true;
        confirmSubmit.textContent = 'UPDATING BOOKING...';

        fetch('/api/payments/failed', {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ razorpay_order_id: orderId, razorpay_payment_id: paymentId })
        }).then(async (response) => {
          const result = await response.json();
          if (!response.ok || !result.success) {
            throw new Error(result.message || 'Could not update the booking payment status.');
          }
          activeOrder = null;
          paymentFailureSaving = false;
          confirmSubmit.disabled = false;
          confirmSubmit.textContent = 'RETRY PAYMENT';
        }).catch((error) => {
          paymentFailureSaving = false;
          paymentFailureMessage += ` The booking status could not be updated: ${error.message}`;
          confirmStatus.textContent = paymentFailureMessage;
          confirmSubmit.disabled = false;
          confirmSubmit.textContent = 'RETRY PAYMENT';
        });
      });

      rzpInstance.open();
    }

    let checkoutSubmissionInProgress = false;
    confirmSubmit.addEventListener('click', async () => {
      if (checkoutSubmissionInProgress) return;
      checkoutSubmissionInProgress = true;
      if (!userData && loginRequiredModal) {
        bookingConfirmation.classList.remove('is-open');
        loginRequiredModal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
        checkoutSubmissionInProgress = false;
        return;
      }

      paymentFailureMessage = '';
      confirmStatus.classList.remove('text-red-300', 'border-red-500/40', 'bg-red-500/10');
      confirmStatus.setAttribute('role', 'status');
      confirmStatus.setAttribute('aria-live', 'polite');
      confirmSubmit.disabled = true;

      if (pendingVerification) {
        try {
          await verifyPayment(pendingVerification);
        } catch (error) {
          confirmStatus.classList.remove('hidden', 'text-neutral-300', 'text-[#00D06C]');
          confirmStatus.classList.add('text-red-400');
          confirmStatus.textContent = error.message || 'Payment verification failed. Please try again.';
          confirmSubmit.disabled = false;
          confirmSubmit.textContent = 'RETRY VERIFICATION';
        } finally {
          checkoutSubmissionInProgress = false;
        }
        return;
      }

      try {
        if (selectedPaymentMethod === 'WALLET' && !activeBooking) {
          await loadWalletBalance();
          if (walletBalance === null) {
            walletPaymentStatus.textContent = walletBalanceError || 'Wallet balance is unavailable. Choose Razorpay to continue.';
            walletPaymentBlocked = true;
            confirmSubmit.disabled = true;
            confirmSubmit.textContent = 'WALLET UNAVAILABLE';
            return;
          }
        }

        if (!activeBooking) {
          confirmSubmit.textContent = 'CREATING BOOKING...';
          confirmStatus.classList.remove('hidden', 'text-red-400', 'text-[#00D06C]');
          confirmStatus.classList.add('text-neutral-300');
          confirmStatus.textContent = 'Creating your appointment booking...';

          const bookingResponse = await fetch('/api/bookings', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify({
              serviceIds: bookingService.value.split(',').filter(Boolean),
              date: bookingDate.value,
              startTime: bookingTime.value
            })
          });

          let bookingData;
          try {
            bookingData = await bookingResponse.json();
          } catch (e) {
            throw new Error('Failed to read booking response from server.');
          }

          if (!bookingResponse.ok || !bookingData.success || !bookingData.booking?._id) {
            throw new Error(bookingData.message || 'Booking creation failed.');
          }

          activeBooking = bookingData.booking;
        }

        if (selectedPaymentMethod === 'WALLET') {
          confirmStatus.classList.remove('hidden', 'text-red-400', 'text-[#00D06C]');
          confirmStatus.classList.add('text-neutral-300');
          confirmStatus.textContent = 'Checking wallet balance against the booking advance…';
          await loadWalletBalance();
          evaluateWalletPayment(true);
          confirmStatus.classList.remove('text-neutral-300');
          if (walletBalance === null || Number(activeBooking.advanceAmount) > walletBalance) {
            confirmStatus.classList.add('text-red-300', 'border-red-500/40', 'bg-red-500/10');
            confirmStatus.setAttribute('role', 'alert');
            confirmStatus.setAttribute('aria-live', 'assertive');
            confirmStatus.textContent = walletDifference.textContent || walletPaymentStatus.textContent;
            return;
          }

          walletPaymentStatus.textContent = 'Processing your wallet payment…';
          confirmStatus.classList.remove('text-red-300', 'border-red-500/40', 'bg-red-500/10');
          confirmStatus.classList.add('text-neutral-300');
          confirmStatus.textContent = 'Processing your wallet payment…';

          const walletResponse = await fetch('/api/payments/wallet', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify({ bookingId: activeBooking._id })
          });

          let walletData;
          try {
            walletData = await walletResponse.json();
          } catch (error) {
            if (walletResponse.status === 404) {
              throw new Error('Wallet payment is currently unavailable. Please choose Razorpay.');
            }
            throw new Error('Could not read the wallet payment response. Please try again.');
          }

          if (!walletResponse.ok || walletData?.success !== true) {
            throw new Error(walletData?.message || 'Wallet payment failed. Please try again or choose Razorpay.');
          }

          activeBooking = walletData.booking || activeBooking;
          confirmStatus.classList.remove('hidden', 'text-neutral-300', 'text-red-400', 'text-red-300', 'border-red-500/40', 'bg-red-500/10');
          confirmStatus.classList.add('text-[#00D06C]');
