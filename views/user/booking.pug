extends ../layouts/minimal.pug

block content
  -
    const bookingServiceGroups = typeof serviceGroups !== 'undefined' && Array.isArray(serviceGroups) ? serviceGroups : [];

  div(class="mx-auto flex w-full max-w-6xl flex-1 flex-col py-8 sm:py-12")
    a(href="/", class="mb-8 w-fit font-mono text-xs font-bold tracking-[0.15em] text-neutral-500 transition hover:text-[#00D06C]") ← BACK HOME

    div(class="mb-10 grid gap-6 border-b border-neutral-200 pb-8 sm:mb-12 sm:grid-cols-[1fr_auto] sm:items-end")
      div
        p(class="mb-4 font-mono text-[10px] tracking-[0.3em] text-neutral-400") SCISS’ BARBER · KOZHIKODE
        h1(class="text-[clamp(3rem,9vw,6.5rem)] font-bold leading-[0.88] tracking-[-0.08em]") BOOK YOUR VISIT.
      p(class="max-w-xs text-sm leading-relaxed text-neutral-500") Choose a service and a time that works for you. We’ll have the chair ready.

    form#booking-form(class="grid gap-10 lg:grid-cols-[1fr_0.72fr]")
      div(class="space-y-10")
        fieldset
          legend(class="mb-4 font-mono text-[11px] font-bold tracking-[0.2em]") 01 / SELECT A SERVICE
          p(class="mb-4 text-xs text-neutral-500") Pick a category to see its services and prices.
          div#service-categories(class="flex flex-wrap gap-2")
            each group, index in bookingServiceGroups
              button(type="button", data-service-category=group.title, aria-pressed=index === 0, class=index === 0 ? "booking-category-chip is-active" : "booking-category-chip")= group.title
          div#service-options(class="mt-4 grid gap-3 sm:grid-cols-2")
            if bookingServiceGroups.length
              p#service-prompt(class="rounded-2xl border border-dashed border-neutral-300 px-5 py-6 text-sm text-neutral-400 sm:col-span-2") Choose a service category to view the menu.
            else
              p#service-prompt(class="rounded-2xl border border-dashed border-neutral-300 px-5 py-6 text-sm text-neutral-400 sm:col-span-2") Services are currently unavailable.
          input#booking-service(type="hidden", name="service")
          input#booking-time(type="hidden", name="time")
          input#booking-end-time(type="hidden", name="endTime")
          a(href="/services", class="mt-3 inline-flex text-xs font-semibold text-neutral-500 transition hover:text-[#00D06C]") View the full services & price list →

        fieldset
          legend(class="mb-4 font-mono text-[11px] font-bold tracking-[0.2em]") 02 / DATE & TIME
          p(class="mb-3 text-xs text-neutral-500") Choose a day
          div#date-choices(class="grid grid-cols-3 gap-2 sm:grid-cols-7")
          label(class="mt-3 flex flex-col gap-2 text-xs text-neutral-500 sm:flex-row sm:items-center sm:justify-between")
            span Or pick another date
            input#booking-date(type="date", name="date", required, class="w-full rounded-xl border border-neutral-200 bg-transparent px-4 py-3 text-sm text-neutral-950 outline-none focus:border-[#00D06C] sm:w-auto")
          div(class="mt-6")
            p(class="mb-3 text-xs text-neutral-500") Choose a preferred time
            div#time-choices(class="grid grid-cols-2 gap-2 sm:grid-cols-3", aria-live="polite")
              p#time-slots-state(class="col-span-full rounded-xl border border-dashed border-neutral-300 px-4 py-4 text-sm text-neutral-400", role="status") Choose a service and date to see available times.

        fieldset
          legend(class="mb-4 font-mono text-[11px] font-bold tracking-[0.2em]") 03 / YOUR DETAILS
          div(class="grid gap-4 sm:grid-cols-2")
            label(class="block sm:col-span-2")
              span(class="mb-2 block text-xs text-neutral-500") Full name
              input(type="text", name="name", autocomplete="name", required, class="w-full border-0 border-b border-neutral-300 bg-transparent py-3 text-sm outline-none focus:border-[#00D06C]")
            label(class="block")
              span(class="mb-2 block text-xs text-neutral-500") Email
              input(type="email", name="email", autocomplete="email", required, class="w-full border-0 border-b border-neutral-300 bg-transparent py-3 text-sm outline-none focus:border-[#00D06C]")
            label(class="block")
              span(class="mb-2 block text-xs text-neutral-500") Phone
              input(type="tel", name="phone", autocomplete="tel", required, class="w-full border-0 border-b border-neutral-300 bg-transparent py-3 text-sm outline-none focus:border-[#00D06C]")

      aside(class="h-fit rounded-2xl bg-neutral-950 p-6 text-white sm:p-8")
        p(class="font-mono text-[10px] tracking-[0.25em] text-neutral-400") YOUR APPOINTMENT
        h2(class="mb-8 mt-3 text-2xl font-bold tracking-tight") Ready when you are.
        p(class="mb-8 text-sm leading-relaxed text-neutral-400") Review your service, date, and time before you continue.
        div(class="mb-6 border-y border-white/15 py-5")
          div(class="flex items-start justify-between gap-4")
            div
              p(class="font-mono text-[9px] tracking-[0.16em] text-neutral-400") SELECTED SERVICE
              p#summary-service(class="mt-2 text-sm font-semibold") Choose a service
            div(class="text-right")
              p(class="font-mono text-[9px] tracking-[0.16em] text-neutral-400") PRICE
              p#summary-price(class="mt-2 text-sm font-bold text-[#00D06C]") —
          p#summary-datetime(class="mt-4 text-xs text-neutral-400") Select your date and time
        button(type="submit", class="flex h-14 w-full items-center justify-between rounded-full bg-[#00D06C] px-6 font-mono text-xs font-bold tracking-[0.12em] text-black transition hover:bg-white")
          span REVIEW APPOINTMENT
          span(class="text-lg") →
        p#booking-status.mt-5.text-sm.leading-relaxed.text-neutral-300(role="status", aria-live="polite")

  script#booking-service-data(type="application/json")!= JSON.stringify(bookingServiceGroups).replace(/</g, '\\u003c')

  script.
    const bookingForm = document.getElementById('booking-form');
    const bookingDate = document.getElementById('booking-date');
    const bookingService = document.getElementById('booking-service');
    const bookingTime = document.getElementById('booking-time');
    const bookingEndTime = document.getElementById('booking-end-time');
    const serviceGroups = JSON.parse(document.getElementById('booking-service-data').textContent);
    const serviceCategories = document.getElementById('service-categories');
    const serviceOptions = document.getElementById('service-options');
    const dateChoices = document.getElementById('date-choices');
    const timeChoices = document.getElementById('time-choices');
    const summaryService = document.getElementById('summary-service');
    const summaryPrice = document.getElementById('summary-price');
    const summaryDateTime = document.getElementById('summary-datetime');
    const today = new Date();
    const localToday = new Date(today.getTime() - today.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
    bookingDate.min = localToday;

    function formatServicePrice(price) {
      if (price === null || price === undefined || price === '') return 'Price unavailable';
      const numericPrice = Number(price);
      return Number.isFinite(numericPrice)
        ? `₹${numericPrice.toLocaleString('en-IN')}`
        : String(price);
    }

    function updateBookingSummary() {
      const selectedName = bookingService.dataset.name || '';
      const selectedPrice = bookingService.dataset.price || '';
      const selectedDate = bookingDate.value;
      const selectedTime = bookingTime.dataset.label || bookingTime.value;
      const selectedEndTime = bookingEndTime.dataset.label || bookingEndTime.value;
      const prettyDate = selectedDate
        ? new Date(selectedDate + 'T00:00:00').toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })
        : '';
      summaryService.textContent = selectedName || 'Choose a service';
      summaryPrice.textContent = !selectedPrice
        ? '—'
        : selectedPrice === 'Ask in shop'
          ? 'Confirm in shop'
          : formatServicePrice(selectedPrice);
      summaryDateTime.textContent = prettyDate || selectedTime
        ? (prettyDate || 'Choose a date') + (selectedTime ? ' · ' + selectedTime : '') + (selectedEndTime ? ' – ' + selectedEndTime : '')
        : 'Select your date and time';
    }

    function setServiceCategory(categoryName) {
      serviceCategories.querySelectorAll('[data-service-category]').forEach((button) => {
        const isSelected = button.dataset.serviceCategory === categoryName;
        button.classList.toggle('is-active', isSelected);
        button.setAttribute('aria-pressed', String(isSelected));
      });

      const group = serviceGroups.find((item) => item.title === categoryName);
      serviceOptions.replaceChildren();
      bookingService.value = '';
      bookingService.dataset.name = '';
      bookingService.dataset.price = '';
      bookingService.dataset.duration = '';
      bookingTime.value = '';
      bookingTime.dataset.label = '';
      bookingEndTime.value = '';
      bookingEndTime.dataset.label = '';
      updateBookingSummary();
      loadAvailableTimeSlots();

      if (!group || !Array.isArray(group.items) || group.items.length === 0) {
        const prompt = document.createElement('p');
        prompt.className = 'rounded-2xl border border-dashed border-neutral-300 px-5 py-6 text-sm text-neutral-400 sm:col-span-2';
        prompt.textContent = group ? 'No services are available in this category.' : 'Choose a service category to view the menu.';
        serviceOptions.appendChild(prompt);
        return;
      }

      group.items.forEach((service) => {
        const option = document.createElement('button');
        option.type = 'button';
        option.className = 'booking-service-card';
        option.dataset.serviceId = service._id || '';
        option.dataset.serviceName = service.name || '';
        option.dataset.price = service.price ?? '';
        option.dataset.duration = service.duration ?? '';

        const serviceName = document.createElement('span');
        serviceName.className = 'text-sm font-semibold';
        serviceName.textContent = service.name || 'Unnamed service';

        const servicePrice = document.createElement('span');
        servicePrice.className = 'font-mono text-xs font-bold';
        servicePrice.textContent = formatServicePrice(service.price);

        option.append(serviceName, servicePrice);
        option.addEventListener('click', () => {
          serviceOptions.querySelectorAll('.booking-service-card').forEach((card) => {
            card.classList.remove('is-selected');
          });
          option.classList.add('is-selected');
          bookingService.value = option.dataset.serviceId;
          bookingService.dataset.name = option.dataset.serviceName;
          bookingService.dataset.price = option.dataset.price;
          bookingService.dataset.duration = option.dataset.duration;
          bookingTime.value = '';
          bookingTime.dataset.label = '';
          bookingEndTime.value = '';
          bookingEndTime.dataset.label = '';
          updateBookingSummary();
          loadAvailableTimeSlots();
        });

        serviceOptions.appendChild(option);
      });
    }

    serviceCategories.addEventListener('click', (event) => {
      const categoryButton = event.target.closest('[data-service-category]');
      if (categoryButton) setServiceCategory(categoryButton.dataset.serviceCategory);
    });

    let timeSlotRequestId = 0;

    function showTimeSlotState(state, message) {
      const stateMessage = document.createElement('p');
      const stateColor = state === 'error' ? 'text-red-600' : 'text-neutral-400';
      stateMessage.className = `col-span-full rounded-xl border border-dashed border-neutral-300 px-4 py-4 text-sm ${stateColor}`;
      stateMessage.setAttribute('role', state === 'error' ? 'alert' : 'status');
      stateMessage.textContent = message;
      timeChoices.replaceChildren(stateMessage);
    }

    async function requestAvailableTimeSlots(serviceId, dateValue) {
      const response = await fetch(
        `/api/bookings/available-slots?serviceId=${encodeURIComponent(serviceId)}&date=${encodeURIComponent(dateValue)}`,
        {
          method: 'POST',
          headers: { 'Accept': 'application/json' }
        }
      );

      let data;
      try {
        data = await response.json();
      } catch (error) {
        throw new Error('The availability response could not be read.');
      }

      if (!response.ok || !data.success) {
        throw new Error(data.message || 'Failed to fetch available time slots.');
      }

      return data.slots;
    }

    function formatAvailableTime(value) {
      const timeValue = String(value);
      if (/^\d{1,2}:\d{2}$/.test(timeValue)) {
        const [hour, minute] = timeValue.split(':').map(Number);
        return new Date(2000, 0, 1, hour, minute).toLocaleTimeString('en-IN', { hour: 'numeric', minute: '2-digit' });
      }
      const dateValue = new Date(timeValue);
      return Number.isNaN(dateValue.getTime())
        ? timeValue
        : dateValue.toLocaleTimeString('en-IN', { hour: 'numeric', minute: '2-digit' });
    }

    async function loadAvailableTimeSlots() {
      const requestId = ++timeSlotRequestId;
      bookingTime.value = '';
      bookingTime.dataset.label = '';
      bookingEndTime.value = '';
      bookingEndTime.dataset.label = '';

      if (!bookingService.value || !bookingDate.value) {
        showTimeSlotState('empty', 'Choose a service and date to see available times.');
        updateBookingSummary();
        return;
      }

      showTimeSlotState('loading', 'Checking available times…');
      try {
        const slots = await requestAvailableTimeSlots(bookingService.value, bookingDate.value);
        if (requestId !== timeSlotRequestId) return;
        if (!Array.isArray(slots)) throw new Error('The availability response is not a list of time slots.');
        if (slots.length === 0) {
          showTimeSlotState('empty', 'No available times for this service and date.');
          return;
        }

        const slotButtons = slots.map((slot) => {
          const startTime = slot?.startTime;
          const endTime = slot?.endTime;
          if (!startTime || !endTime) return null;
          const slotButton = document.createElement('button');
          slotButton.type = 'button';
          slotButton.dataset.timeSlot = String(startTime);
          slotButton.dataset.timeEnd = String(endTime);
          slotButton.dataset.timeLabel = formatAvailableTime(startTime);
          slotButton.dataset.timeEndLabel = formatAvailableTime(endTime);
          slotButton.className = 'booking-time-chip';
          slotButton.textContent = slotButton.dataset.timeLabel;
          return slotButton;
        }).filter(Boolean);

        if (slotButtons.length === 0) {
          showTimeSlotState('empty', 'No available times for this service and date.');
          return;
        }
        timeChoices.replaceChildren(...slotButtons);
      } catch (error) {
        if (requestId === timeSlotRequestId) {
          showTimeSlotState('error', `Unable to load available times. ${error.message || 'Please try again.'}`);
        }
      }
    }

    if (serviceGroups.length) setServiceCategory(serviceGroups[0].title);

    function setDate(dateValue, selectedButton) {
      bookingDate.value = dateValue;
      dateChoices.querySelectorAll('.booking-date-chip').forEach((button) => button.classList.remove('is-selected'));
      if (selectedButton) selectedButton.classList.add('is-selected');
      bookingTime.value = '';
      bookingTime.dataset.label = '';
      bookingEndTime.value = '';
      bookingEndTime.dataset.label = '';
      updateBookingSummary();
      loadAvailableTimeSlots();
    }

    for (let offset = 0; offset < 7; offset += 1) {
      const date = new Date(today.getFullYear(), today.getMonth(), today.getDate() + offset);
      const isoDate = date.getFullYear() + '-' + String(date.getMonth() + 1).padStart(2, '0') + '-' + String(date.getDate()).padStart(2, '0');
      const dayButton = document.createElement('button');
      dayButton.type = 'button';
      dayButton.className = 'booking-date-chip';
      dayButton.dataset.date = isoDate;
      const dayName = document.createElement('span');
      dayName.className = 'font-mono text-[9px] tracking-[0.08em]';
      dayName.textContent = offset === 0 ? 'TODAY' : date.toLocaleDateString('en-IN', { weekday: 'short' }).toUpperCase();
      const dayNumber = document.createElement('span');
      dayNumber.className = 'text-xl font-bold';
      dayNumber.textContent = String(date.getDate());
      const monthName = document.createElement('span');
      monthName.className = 'font-mono text-[8px] tracking-[0.08em]';
      monthName.textContent = date.toLocaleDateString('en-IN', { month: 'short' }).toUpperCase();
      dayButton.append(dayName, dayNumber, monthName);
      dayButton.addEventListener('click', () => setDate(isoDate, dayButton));
      dateChoices.appendChild(dayButton);
    }

    bookingDate.addEventListener('change', () => {
      dateChoices.querySelectorAll('.booking-date-chip').forEach((button) => {
        button.classList.toggle('is-selected', button.dataset.date === bookingDate.value);
      });
      bookingTime.value = '';
      bookingTime.dataset.label = '';
      bookingEndTime.value = '';
      bookingEndTime.dataset.label = '';
      updateBookingSummary();
      loadAvailableTimeSlots();
    });

    timeChoices.addEventListener('click', (event) => {
      const timeButton = event.target.closest('[data-time-slot]');
      if (!timeButton) return;
      timeChoices.querySelectorAll('[data-time-slot]').forEach((button) => button.classList.remove('is-selected'));
      timeButton.classList.add('is-selected');
      bookingTime.value = timeButton.dataset.timeSlot;
      bookingTime.dataset.label = timeButton.dataset.timeLabel || timeButton.dataset.timeSlot;
      bookingEndTime.value = timeButton.dataset.timeEnd;
      bookingEndTime.dataset.label = timeButton.dataset.timeEndLabel || bookingEndTime.value;
      updateBookingSummary();
    });

    bookingForm.addEventListener('submit', (event) => {
      event.preventDefault();
      const status = document.getElementById('booking-status');
      if (!bookingService.value) {
        status.textContent = 'Choose a service to continue.';
        return;
      }
      if (!bookingTime.value) {
        status.textContent = 'Choose a preferred time to continue.';
        return;
      }
      const values = new FormData(bookingForm);
      const selectedPrice = bookingService.dataset.price;
      const priceMessage = selectedPrice === 'Ask in shop' ? 'Price to be confirmed in shop' : formatServicePrice(selectedPrice);
      status.textContent = bookingService.dataset.name + ' · ' + priceMessage + ' · ' + values.get('date') + ' at ' + values.get('time') + '. Details ready for review; booking confirmation is not connected yet.';
    });
