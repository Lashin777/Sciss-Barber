doctype html
- const dashboardData = typeof dashboard !== 'undefined' && dashboard && typeof dashboard === 'object' ? dashboard : {}
- const appointmentRows = Array.isArray(dashboardData.appointments) ? dashboardData.appointments : []
- const dailyGross = dashboardData.dailyGross ?? '—'
- const bookedSessions = dashboardData.bookedSessions ?? '—'
- const adminNavigation = [{ label: 'Dashboard', icon: 'overview', active: true }, { label: 'Booking', icon: 'booking' }, { label: 'Calendar', icon: 'calendar' }, { label: 'Customers', icon: 'customers', href: '/admin/users' }, { label: 'Services', icon: 'services' }, { label: 'Payments', icon: 'payments' }, { label: 'Revenue', icon: 'revenue' }, { label: 'Profile', icon: 'profile' }]
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    meta(name="theme-color", content="#191a20")
    title Admin Dashboard | Sciss Barber
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap", rel="stylesheet")
    link(rel="stylesheet", href="/css/output.css")
    style.
      #admin-shell {
        display: flex;
        min-width: 0;
      }
      #admin-sidebar {
        position: relative;
        width: 220px;
        min-width: 220px;
        flex: 0 0 220px;
        height: 100dvh;
        overflow: hidden;
        transition: width 360ms cubic-bezier(0.22, 1, 0.36, 1), min-width 360ms cubic-bezier(0.22, 1, 0.36, 1), flex-basis 360ms cubic-bezier(0.22, 1, 0.36, 1);
      }
      #admin-shell.sidebar-collapsed {
        overflow: hidden;
      }
      #admin-shell.sidebar-collapsed #admin-sidebar {
        width: 0;
        min-width: 0;
        flex-basis: 0;
      }
      #admin-sidebar > * {
        width: min(220px, 85vw);
        min-width: min(220px, 85vw);
        opacity: 1;
        transition: opacity 180ms ease 90ms;
      }
      #admin-sidebar-toggle {
        position: fixed;
        top: 50%;
        left: 0;
        z-index: 60;
        display: flex;
        width: 36px;
        height: 36px;
        align-items: center;
        justify-content: center;
        gap: 2px;
        transform: translateY(-50%);
        border: 1px solid rgb(255 255 255 / 16%);
        border-left: 0;
        border-radius: 0 10px 10px 0;
        background: #191a20;
        color: #00D06C;
        box-shadow: 0 5px 16px rgb(17 18 22 / 15%);
        transition: left 360ms cubic-bezier(0.22, 1, 0.36, 1), background-color 140ms ease, box-shadow 140ms ease;
      }
      #admin-shell.sidebar-visible #admin-sidebar-toggle {
        left: 202px;
      }
      #admin-shell.sidebar-collapsed #admin-sidebar > * {
        opacity: 0;
        pointer-events: none;
        transition-delay: 0ms;
      }
      #admin-sidebar-toggle:hover {
        background: #25262d;
        box-shadow: 0 7px 18px rgb(17 18 22 / 20%);
      }
      #admin-sidebar-toggle .sidebar-toggle-arrow {
        width: 10px;
        height: 10px;
        opacity: 0.55;
        transform-box: fill-box;
        transform-origin: center;
        transition: transform 240ms ease-in-out;
      }
      #admin-sidebar-toggle:hover .sidebar-toggle-arrow {
        opacity: 0.8;
      }
      #admin-shell.sidebar-visible .sidebar-toggle-arrow {
        transform: rotate(180deg);
      }
      #admin-sidebar-toggle .sidebar-toggle-mark {
        font: 700 9px/1 'Space Mono', monospace;
        letter-spacing: -0.04em;
      }
      @media (max-width: 1023px) {
        #admin-sidebar {
          width: min(220px, 85vw);
          min-width: min(220px, 85vw);
          flex-basis: min(220px, 85vw);
        }
        #admin-shell.sidebar-visible #admin-sidebar-toggle {
          left: calc(min(220px, 85vw) - 18px);
        }
      }
      @media (prefers-reduced-motion: reduce) {
        #admin-sidebar,
        #admin-sidebar > *,
        #admin-sidebar-toggle,
        #admin-sidebar-toggle .sidebar-toggle-arrow {
          transition: none !important;
        }
      }
  body(class="min-h-dvh overflow-x-hidden bg-white font-sans text-[#191a20] antialiased lg:h-dvh lg:overflow-hidden")
    svg(class="hidden", xmlns="http://www.w3.org/2000/svg", aria-hidden="true")
      symbol#icon-overview(viewBox="0 0 24 24")
        rect(x="3" y="3" width="7" height="7" rx="1" fill="currentColor")
        rect(x="14" y="3" width="7" height="7" rx="1" fill="currentColor" opacity=".55")
        rect(x="3" y="14" width="7" height="7" rx="1" fill="currentColor" opacity=".55")
        rect(x="14" y="14" width="7" height="7" rx="1" fill="currentColor" opacity=".55")
      symbol#icon-booking(viewBox="0 0 24 24")
        rect(x="6" y="3" width="12" height="18" rx="2" fill="none" stroke="currentColor" stroke-width="1.8")
        path(d="M9 7h6M9 11h6M9 15h3", fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round")
      symbol#icon-calendar(viewBox="0 0 24 24")
        rect(x="3" y="5" width="18" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="1.8")
        path(d="M7 3v4M17 3v4M3 10h18", fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round")
      symbol#icon-customers(viewBox="0 0 24 24")
        circle(cx="9" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.8")
        path(d="M3 20v-1a6 6 0 0 1 12 0v1M16 5.5a3 3 0 0 1 0 5.8M18 14a4 4 0 0 1 3 4v2", fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round")
      symbol#icon-services(viewBox="0 0 24 24")
        circle(cx="6" cy="6" r="3" fill="none" stroke="currentColor" stroke-width="1.8")
        circle(cx="18" cy="18" r="3" fill="none" stroke="currentColor" stroke-width="1.8")
        path(d="m8 8 11 11M16 8l-4 4M8 16l-3 3", fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round")
      symbol#icon-payments(viewBox="0 0 24 24")
        rect(x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.8")
        path(d="M3 10h18M7 15h4", fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round")
      symbol#icon-revenue(viewBox="0 0 24 24")
        path(d="m3 17 6-6 4 3 8-8M15 6h6v6", fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
      symbol#icon-profile(viewBox="0 0 24 24")
        rect(x="4" y="3" width="16" height="18" rx="2" fill="none" stroke="currentColor" stroke-width="1.8")
        circle(cx="12" cy="9" r="2.5" fill="none" stroke="currentColor" stroke-width="1.6")
        path(d="M8 17a4 4 0 0 1 8 0", fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round")
      symbol#icon-user(viewBox="0 0 24 24")
        circle(cx="12" cy="8" r="3.5" fill="none" stroke="currentColor" stroke-width="1.8")
        path(d="M5 21a7 7 0 0 1 14 0", fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round")

    div#admin-shell(class="min-h-dvh sidebar-visible lg:h-dvh lg:overflow-hidden")
      aside#admin-sidebar(class="flex shrink-0 flex-col bg-[#191a20] text-white", aria-label="Admin navigation")
        div(class="flex min-h-[60px] items-center gap-3 border-b border-white/10 px-5 py-2 sm:px-6")
          a(href="#overview", class="flex min-w-0 items-center gap-4")
            span(class="grid size-9 shrink-0 place-items-center rounded-md bg-[#00D06C] font-mono text-sm font-bold text-[#101115]", aria-hidden="true") SB
            span
              strong(class="block text-sm font-bold tracking-[0.09em]") SCISS BARBER
              span(class="mt-1 block font-mono text-[10px] tracking-[0.18em] text-white/45") ADMIN STUDIO
        div(class="px-3 pb-4 pt-4 sm:px-4")
          p(class="mb-3 px-3 font-mono text-[10px] font-bold tracking-[0.18em] text-white/45") MANAGEMENT
          nav(class="flex gap-1 overflow-x-auto pb-1 lg:flex-col lg:overflow-visible", aria-label="Management")
            each item in adminNavigation
              if item.href
                a(href=item.href, class="flex min-w-fit items-center gap-3 rounded-md px-4 py-2.5 text-sm font-semibold text-white/75 transition hover:bg-white/5 hover:text-white")
                  svg(class="size-5 shrink-0", aria-hidden="true")
                    use(href=`#icon-${item.icon}`)
                  span= item.label
              else if item.active
                a(href="#overview", aria-current="page", class="flex min-w-fit items-center gap-3 rounded-md border-l-2 border-[#00D06C] bg-[#2b2c33] px-4 py-2.5 text-sm font-bold text-[#42e990] transition")
                  svg(class="size-5 shrink-0", aria-hidden="true")
                    use(href=`#icon-${item.icon}`)
                  span= item.label
              else
                span(class="flex min-w-fit cursor-not-allowed items-center gap-3 rounded-md px-4 py-2.5 text-sm font-semibold text-white/40", aria-disabled="true", title="Admin page not available yet")
                  svg(class="size-5 shrink-0", aria-hidden="true")
                    use(href=`#icon-${item.icon}`)
                  span= item.label

        div(class="mt-auto flex items-center justify-between border-t border-white/10 px-5 py-3 sm:px-6 lg:items-start lg:gap-3")
          div
            p(class="font-mono text-[9px] font-bold tracking-[0.15em] text-white/45") LOCATION UNIT
            p(class="mt-1 text-xs font-bold tracking-[0.05em]") KOZHIKODE STUDIO
            p(class="mt-1 font-mono text-[9px] tracking-[0.08em] text-white/45") SCISS BARBER
      button#admin-sidebar-toggle(type="button", aria-label="Close sidebar", aria-controls="admin-sidebar", aria-expanded="true")
        span.sidebar-toggle-mark(aria-hidden="true") SB
        svg(class="size-3 sidebar-toggle-arrow", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.5", aria-hidden="true")
          path(d="m9 18 6-6-6-6", stroke-linecap="round", stroke-linejoin="round")
      main(id="overview", class="min-w-0 flex-1 overflow-y-auto lg:flex lg:min-h-0 lg:flex-col")
        div(class="mx-auto flex w-full max-w-7xl flex-1 flex-col px-5 py-8 sm:px-8 sm:py-12 lg:min-h-0 lg:px-12 lg:py-8")
          nav(class="mb-8 flex flex-wrap items-center justify-between gap-4 border-b border-neutral-200 pb-4", aria-label="Admin actions")
            span(class="font-mono text-[10px] font-bold tracking-[0.1em] text-neutral-400") ADMIN / OVERVIEW
            div(class="flex flex-wrap items-center gap-3 sm:gap-6")
              a(href="/", class="font-mono text-[10px] font-bold tracking-[0.1em] text-neutral-500 transition hover:text-[#00D06C]") VIEW SITE
              form(action="/api/admin/logout", method="POST")
                button(type="submit", class="font-mono text-[10px] font-bold tracking-[0.1em] text-neutral-500 transition hover:text-red-600") LOG OUT

          header(class="mb-8 border-b border-neutral-200 pb-6 sm:mb-10", aria-labelledby="overview-heading")
            p(class="mb-2 font-mono text-[10px] tracking-[0.25em] text-neutral-400") ADMIN / DASHBOARD
            h1#overview-heading(class="text-4xl font-bold leading-none tracking-[-0.06em] sm:text-6xl") Dashboard
            p(class="mt-4 max-w-2xl text-sm leading-relaxed text-neutral-500") Daily appointments and revenue at a glance.

          section(class="grid shrink-0 gap-4 sm:grid-cols-2", aria-label="Daily metrics")
            article(class="border border-neutral-200 bg-white px-5 py-4 sm:px-6")
              div(class="flex items-center justify-between gap-4")
                h2(class="font-mono text-[10px] font-bold tracking-[0.15em] text-neutral-400") DAILY GROSS
              p(class="mt-3 text-3xl font-bold tracking-[-0.06em] sm:text-4xl")= dailyGross
            article(class="border border-neutral-200 bg-white px-5 py-4 sm:px-6")
              div(class="flex items-center justify-between gap-4")
                h2(class="font-mono text-[10px] font-bold tracking-[0.15em] text-neutral-400") BOOKED SESSIONS
              p(class="mt-3 flex items-baseline gap-3")
                strong(class="text-3xl font-bold tracking-[-0.06em] sm:text-4xl")= bookedSessions

          section(class="mt-8 flex min-h-0 flex-1 flex-col", aria-labelledby="schedule-heading")
            div(class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between")
              div
                p(class="font-mono text-[10px] tracking-[0.2em] text-neutral-400") APPOINTMENTS
                h2#schedule-heading(class="mt-2 text-2xl font-bold tracking-[-0.06em]") Today’s schedule
              p(class="font-mono text-[9px] font-bold tracking-[0.13em] text-neutral-400")= new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).toUpperCase() + ' · KOZHIKODE'
            div(class="min-h-0 flex-1 overflow-auto border border-neutral-200")
              table(class="w-full min-w-[800px] border-collapse text-left")
                thead
                  tr(class="border-b border-neutral-200 bg-neutral-50 font-mono text-[10px] tracking-[0.15em] text-neutral-500")
                    th(scope="col", class="px-5 py-4 text-left font-normal") TIME
                    th(scope="col", class="px-5 py-4 text-left font-normal") CUSTOMER
                    th(scope="col", class="px-5 py-4 text-left font-normal") SERVICE
                    th(scope="col", class="px-5 py-4 text-right font-normal") AMOUNT
                    th(scope="col", class="px-5 py-4 text-center font-normal") STATUS
                tbody
                  if appointmentRows.length
                    each appointment in appointmentRows
                      - const cancelled = appointment.status === 'CANCELLED'
                      - const checkedIn = appointment.status === 'CHECKED IN'
                      tr(class=cancelled ? "border-b border-neutral-100 text-neutral-400" : "border-b border-neutral-100 text-neutral-900")
                        td(class=cancelled ? "whitespace-nowrap px-5 py-4 line-through" : "whitespace-nowrap px-5 py-4")
                          strong(class="text-sm font-bold tracking-[-0.02em]")= appointment.time
                          span(class="ml-1 text-[10px] text-[#85868a]")= appointment.period
                        td(class=cancelled ? "whitespace-nowrap px-5 py-4 text-sm font-bold line-through" : "whitespace-nowrap px-5 py-4 text-sm font-bold")= appointment.customer
                        td(class=cancelled ? "whitespace-nowrap px-5 py-4 text-sm text-neutral-500 line-through" : "whitespace-nowrap px-5 py-4 text-sm text-neutral-500")= appointment.service
                        td(class=cancelled ? "whitespace-nowrap px-5 py-4 text-right text-sm font-bold line-through" : "whitespace-nowrap px-5 py-4 text-right text-sm font-bold")= appointment.amount
                        td(class="px-5 py-4 text-center")
                          if checkedIn
                            span(class="inline-flex whitespace-nowrap items-center gap-2 rounded-full border border-[#34353b] px-3 py-1.5 font-mono text-[9px] font-bold tracking-[0.04em] text-[#33343a]")
                              span(class="size-1.5 rounded-full bg-[#34353b]", aria-hidden="true")
                              = appointment.status
                          else if cancelled
                            span(class="inline-flex whitespace-nowrap items-center gap-2 rounded-full border border-[#f2bcbc] px-3 py-1.5 font-mono text-[9px] font-bold tracking-[0.04em] text-[#cb3636]")
                              span(class="size-1.5 rounded-full bg-[#cb3636]", aria-hidden="true")
                              = appointment.status
                          else
                            span(class="inline-flex whitespace-nowrap items-center gap-2 rounded-full bg-[#00D06C] px-3 py-1.5 font-mono text-[9px] font-bold tracking-[0.04em] text-[#10251a]")
                              span(class="size-1.5 rounded-full bg-[#10251a]", aria-hidden="true")
                              = appointment.status
                  else
                    tr
                      td(colspan="5", class="px-4 py-12 text-center text-sm text-[#77787d]") No appointment data available.

    script.
      const adminShell = document.getElementById('admin-shell');
      const adminSidebar = document.getElementById('admin-sidebar');
      const sidebarToggle = document.getElementById('admin-sidebar-toggle');

      function setSidebarOpen(isOpen) {
        adminShell.classList.toggle('sidebar-visible', isOpen);
        adminShell.classList.toggle('sidebar-collapsed', !isOpen);
        adminSidebar.inert = !isOpen;
        sidebarToggle.setAttribute('aria-expanded', String(isOpen));
        sidebarToggle.setAttribute('aria-label', isOpen ? 'Close sidebar' : 'Open sidebar');
      }

      setSidebarOpen(true);
      sidebarToggle.addEventListener('click', () => {
        const isOpen = adminShell.classList.contains('sidebar-visible');
        setSidebarOpen(!isOpen);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && sidebarToggle.getAttribute('aria-expanded') === 'true') {
          setSidebarOpen(false);
          sidebarToggle.focus();
        }
      });

