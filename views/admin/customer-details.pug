extends ../layouts/minimal.pug

block content
  -
    const displayValue = value => value === undefined || value === null || value === '' ? 'Not available' : value;
    const formatDate = value => {
      if (!value) return 'Not available';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return 'Not available';
      return date.toLocaleString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: 'numeric', minute: '2-digit' });
    };
    const getProfileImageUrl = value => {
      if (typeof value !== 'string') return '';
      const imageUrl = value.trim();
      if (imageUrl.startsWith('/uploads/') && !imageUrl.includes('..')) return imageUrl;
      try {
        const url = new URL(imageUrl);
        return ['http:', 'https:'].includes(url.protocol) ? url.href : '';
      } catch {
        return '';
      }
    };
    const statusClasses = {
      ACTIVE: 'rounded-full bg-green-50 px-3 py-1.5 font-mono text-[9px] font-bold tracking-[0.1em] text-green-800',
      BLOCKED: 'rounded-full bg-red-50 px-3 py-1.5 font-mono text-[9px] font-bold tracking-[0.1em] text-red-700',
      UNKNOWN: 'rounded-full bg-neutral-100 px-3 py-1.5 font-mono text-[9px] font-bold tracking-[0.1em] text-neutral-600'
    };

  section(class="mx-auto flex w-full max-w-7xl flex-1 flex-col py-8 sm:py-12")
    nav(class="mb-8 flex flex-wrap items-center justify-between gap-4 border-b border-neutral-200 pb-4", aria-label="Admin navigation")
      a(href="/admin/users", class="flex items-center gap-3 font-mono text-sm font-bold tracking-[0.12em] transition hover:text-[#00D06C]")
        span(class="grid size-9 place-items-center rounded-full bg-[#00D06C] text-base text-black", aria-hidden="true") S
        | SCISS’ ADMIN
      div(class="flex flex-wrap items-center gap-3 sm:gap-6")
        a(href="/admin/users", aria-current="page", class="rounded-full bg-neutral-950 px-4 py-2.5 font-mono text-[10px] font-bold tracking-[0.1em] text-white transition hover:bg-[#00D06C] hover:text-black") ← BACK TO CUSTOMER LIST
        a(href="/", class="font-mono text-[10px] font-bold tracking-[0.1em] text-neutral-500 transition hover:text-[#00D06C]") VIEW SITE
        form(action="/api/admin/logout", method="POST")
          button(type="submit", class="font-mono text-[10px] font-bold tracking-[0.1em] text-neutral-500 transition hover:text-red-600") LOG OUT

    main(class="min-w-0 flex-1")
      header(class="mb-8 border-b border-neutral-200 pb-6 sm:mb-10")
        p(class="mb-3 font-mono text-[10px] tracking-[0.25em] text-neutral-400") ADMIN / CUSTOMER ACCOUNTS
        h1(class="text-4xl font-bold leading-none tracking-[-0.06em] sm:text-6xl") CUSTOMER DETAILS
        p(class="mt-4 max-w-2xl text-sm leading-relaxed text-neutral-500") Review this customer’s profile and account information.

      if customer
        - const customerName = customer.name || 'Customer';
        - const initials = customerName.trim().split(/\s+/).filter(Boolean).map(part => part[0]).slice(0, 2).join('').toUpperCase() || '?';
        - const customerId = customer._id;
        - const profileImageUrl = getProfileImageUrl(customer.profileImage);
        - const status = typeof customer.status === 'string' ? customer.status.toUpperCase() : '';
        - const statusLabel = status === 'ACTIVE' || status === 'BLOCKED' ? status : 'UNKNOWN STATUS';
        - const statusClass = statusClasses[status] || statusClasses.UNKNOWN;
        - const emailVerification = customer.isEmailVerified === true ? 'Verified' : customer.isEmailVerified === false ? 'Not verified' : 'Not available';
        section(class="space-y-5")
          article(class="rounded-2xl border border-neutral-200 bg-white p-6 sm:p-8")
            div(class="flex flex-col gap-6 sm:flex-row sm:items-center")
              div(class="relative grid size-24 shrink-0 place-items-center overflow-hidden rounded-full bg-[#00D06C] font-mono text-2xl font-bold text-black")
                span(aria-hidden="true")= initials
                if profileImageUrl
                  img(src=profileImageUrl, alt=`${customerName} profile photo`, class="absolute inset-0 h-full w-full object-cover", onerror="this.remove()")
              div(class="min-w-0 flex-1")
                div(class="flex flex-wrap items-center gap-3")
                  h2(class="break-all text-2xl font-bold tracking-[-0.04em] sm:text-3xl")= customerName
                  span(class=statusClass)= statusLabel
                p(class="mt-3 break-all text-sm text-neutral-600")= displayValue(customer.email)
                p(class="mt-1 text-sm text-neutral-500")= displayValue(customer.phone)
              div(class="flex flex-wrap gap-2 sm:ml-auto sm:justify-end")
                span(class="rounded-full border border-neutral-200 px-3 py-1.5 font-mono text-[9px] font-bold tracking-[0.1em] text-neutral-600")= displayValue(customer.role).toString().toUpperCase()

          article(class="rounded-2xl border border-neutral-200 bg-white p-6 sm:p-8")
            div(class="mb-6 border-b border-neutral-100 pb-4")
              p(class="mb-2 font-mono text-[9px] tracking-[0.2em] text-neutral-400") CUSTOMER ACCOUNT
              h2(class="text-xl font-bold tracking-tight") Account information
            dl(class="grid gap-5 sm:grid-cols-2")
              div(class="min-w-0")
                dt(class="mb-2 font-mono text-[9px] font-bold tracking-[0.16em] text-neutral-400") CUSTOMER ID
                dd(class="break-all font-mono text-xs leading-relaxed text-neutral-700")= displayValue(customerId)
              div
                dt(class="mb-2 font-mono text-[9px] font-bold tracking-[0.16em] text-neutral-400") REGISTERED
                dd(class="text-sm text-neutral-700")= formatDate(customer.createdAt)
              div
                dt(class="mb-2 font-mono text-[9px] font-bold tracking-[0.16em] text-neutral-400") LAST UPDATED
                dd(class="text-sm text-neutral-700")= formatDate(customer.updatedAt)
              div
                dt(class="mb-2 font-mono text-[9px] font-bold tracking-[0.16em] text-neutral-400") EMAIL VERIFICATION
                dd(class="text-sm text-neutral-700")= emailVerification
              div
                dt(class="mb-2 font-mono text-[9px] font-bold tracking-[0.16em] text-neutral-400") GOOGLE SIGN-IN
                dd(class="text-sm text-neutral-700")= customer.googleId ? 'Connected' : 'Not connected'

      else
        section(class="rounded-2xl border border-dashed border-neutral-300 bg-neutral-50 px-6 py-14 text-center sm:px-10", aria-label="No customer selected")
          span(class="mx-auto grid size-14 place-items-center rounded-full bg-white font-mono text-xl text-neutral-400", aria-hidden="true") —
          h2(class="mt-5 text-xl font-bold tracking-tight") No customer selected
          p(class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-neutral-500") Customer information is unavailable.
