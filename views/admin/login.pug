extends ../layouts/minimal.pug

block content
  section(class="mx-auto flex w-full max-w-6xl flex-1 items-center py-10 sm:py-14")
    div(class="grid w-full overflow-hidden border border-neutral-200 lg:grid-cols-[1fr_0.9fr]")
      div(class="relative flex min-h-64 flex-col justify-between overflow-hidden bg-neutral-950 p-7 text-white sm:p-10 lg:min-h-[540px] lg:p-14")
        div(class="absolute -right-20 -top-20 size-64 rounded-full border border-[#00D06C]/40")
        div(class="absolute -right-10 -top-10 size-44 rounded-full border border-[#00D06C]/30")
        a(href="/", class="relative z-10 w-fit font-mono text-xs font-bold tracking-[0.15em] text-white/70 transition hover:text-[#00D06C]") ← SCISS’ BARBER
        div(class="relative z-10 mt-16 lg:mt-0")
          p(class="mb-4 font-mono text-[10px] tracking-[0.3em] text-[#00D06C]") PRIVATE ACCESS
          h1(class="max-w-lg text-[clamp(3rem,7vw,6rem)] font-bold leading-[0.9] tracking-[-0.07em]") ADMIN
            br
            | PORTAL.
          p(class="mt-6 max-w-sm text-sm leading-relaxed text-neutral-300 sm:text-base") Sign in to manage Sciss’ Barber and review your customer accounts.
        p(class="relative z-10 mt-14 font-mono text-[10px] tracking-[0.2em] text-white/40") KOZHIKODE · SCISS’ BARBER

      div(class="flex flex-col justify-center p-6 sm:p-10 lg:p-14")
        p(class="mb-3 font-mono text-[10px] tracking-[0.25em] text-neutral-400") ADMINISTRATOR SIGN IN
        h2(class="mb-8 text-3xl font-bold tracking-[-0.05em] sm:text-4xl") Welcome back.

        form#admin-login-form(method="POST", action="/api/admin/login", novalidate, class="space-y-6")
          p#admin-login-error(class="hidden text-sm text-red-600", role="alert", aria-live="polite")
          div
            label(for="admin-email", class="mb-1 block font-mono text-[10px] tracking-[0.2em] text-neutral-500") ADMIN EMAIL
            input#admin-email(type="email", name="email", autocomplete="username", required, class="w-full border-0 border-b border-neutral-300 bg-transparent py-3 text-base outline-none transition-colors focus:border-neutral-950")
          div
            label(for="admin-password", class="mb-1 block font-mono text-[10px] tracking-[0.2em] text-neutral-500") PASSWORD
            div(class="relative")
              input#admin-password(type="password", name="password", autocomplete="current-password", required, class="w-full border-0 border-b border-neutral-300 bg-transparent py-3 pr-10 text-base outline-none transition-colors focus:border-neutral-950")
              button(type="button", data-password-toggle="admin-password", data-password-label="admin password", aria-label="Show admin password", class="absolute right-1 top-1/2 -translate-y-1/2 p-2 text-neutral-500 transition hover:text-neutral-950")
                svg(aria-hidden="true", xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", width="18", height="18", fill="none", stroke="currentColor", stroke-width="1.5")
                  path(d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z")
                  circle(cx="12", cy="12", r="2.5")
            a#admin-forgot-password(href="#forgot-password", class="mt-3 block text-right text-xs font-bold text-neutral-500 transition-colors hover:text-[#00D06C]") Forgot password?
          button#admin-login-submit(type="submit", class="h-12 w-full cursor-pointer bg-[#00D06C] font-mono text-xs font-bold tracking-[0.15em] text-black transition-colors hover:bg-neutral-950 hover:text-white") SIGN IN →

        p#admin-login-success(class="mt-5 hidden border-l-2 border-[#00D06C] pl-3 text-sm leading-relaxed text-neutral-600", role="status", aria-live="polite")
        a(href="/", class="mt-8 w-fit text-sm font-bold text-neutral-500 transition-colors hover:text-[#00D06C]") Return to the site

    dialog#admin-reset-modal(class="m-auto w-[calc(100%-2rem)] max-w-md border border-neutral-200 bg-white p-0 shadow-2xl backdrop:bg-black/50 backdrop:backdrop-blur-sm")
      div(class="p-6 sm:p-8")
        p(class="mb-2 font-mono text-[10px] tracking-[0.25em] text-neutral-400") ADMIN ACCOUNT RECOVERY
        h2(class="mb-3 text-2xl font-bold tracking-tight") Reset password
        p(class="mb-5 text-sm leading-relaxed text-neutral-500") Request a verification code, then choose a new password for your admin account.
        p#admin-reset-error(class="mb-4 hidden text-sm text-red-600", role="alert", aria-live="polite")
        p#admin-reset-success(class="mb-4 hidden text-sm text-green-700", role="status", aria-live="polite")
        div#admin-reset-email-step
          label(for="admin-reset-email", class="mb-1 block font-mono text-[10px] tracking-[0.2em] text-neutral-500") ADMIN EMAIL
          input#admin-reset-email(type="email", autocomplete="email", required, class="w-full border-0 border-b border-neutral-300 bg-transparent py-3 text-base outline-none focus:border-neutral-950")
          button#admin-send-reset-code(type="button", class="mt-5 h-11 w-full cursor-pointer bg-neutral-950 font-mono text-[10px] font-bold tracking-[0.12em] text-white transition hover:bg-[#00D06C] hover:text-black") SEND CODE
        div#admin-reset-password-step(class="hidden")
          div(class="mb-4")
            label(for="admin-reset-otp", class="mb-1 block font-mono text-[10px] tracking-[0.2em] text-neutral-500") VERIFICATION CODE
            input#admin-reset-otp(type="text", inputmode="numeric", pattern="[0-9]{6}", maxlength="6", autocomplete="one-time-code", required, class="w-full border-0 border-b border-neutral-300 bg-transparent py-3 text-base outline-none focus:border-neutral-950")
          div
            label(for="admin-new-password", class="mb-1 block font-mono text-[10px] tracking-[0.2em] text-neutral-500") NEW PASSWORD
            div(class="relative")
              input#admin-new-password(type="password", minlength="8", autocomplete="new-password", required, class="w-full border-0 border-b border-neutral-300 bg-transparent py-3 pr-10 text-base outline-none focus:border-neutral-950")
              button(type="button", data-password-toggle="admin-new-password", data-password-label="new admin password", aria-label="Show new admin password", class="absolute right-1 top-1/2 -translate-y-1/2 p-2 text-neutral-500 transition hover:text-neutral-950")
                svg(aria-hidden="true", xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", width="18", height="18", fill="none", stroke="currentColor", stroke-width="1.5")
                  path(d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z")
                  circle(cx="12", cy="12", r="2.5")
          button#admin-save-new-password(type="button", class="mt-5 h-11 w-full cursor-pointer bg-neutral-950 font-mono text-[10px] font-bold tracking-[0.12em] text-white transition hover:bg-[#00D06C] hover:text-black") UPDATE PASSWORD
        button#admin-reset-close(type="button", class="mt-3 w-full py-2 text-sm font-bold text-neutral-500 transition hover:text-neutral-950") CLOSE

  script.
    const adminLoginForm = document.getElementById('admin-login-form');
    const adminLoginError = document.getElementById('admin-login-error');
    const adminLoginSuccess = document.getElementById('admin-login-success');
    const adminLoginSubmit = document.getElementById('admin-login-submit');
    const adminResetModal = document.getElementById('admin-reset-modal');
    const adminResetEmail = document.getElementById('admin-reset-email');
    const adminResetEmailStep = document.getElementById('admin-reset-email-step');
    const adminResetPasswordStep = document.getElementById('admin-reset-password-step');
    const adminResetError = document.getElementById('admin-reset-error');
    const adminResetSuccess = document.getElementById('admin-reset-success');
    const adminEmailInput = document.getElementById('admin-email');
    const adminPasswordInput = document.getElementById('admin-password');

    const markAdminFieldInvalid = (field) => {
      field.classList.remove('border-0', 'border-b', 'border-neutral-300', 'focus:border-neutral-950');
      field.classList.add('rounded-md', 'border', 'border-red-500', 'bg-red-50', 'px-3', 'focus:border-red-500');
      field.setAttribute('aria-invalid', 'true');
    };
    const clearAdminFieldInvalid = (field) => {
      field.classList.remove('rounded-md', 'border', 'border-red-500', 'bg-red-50', 'px-3', 'focus:border-red-500');
      field.classList.add('border-0', 'border-b', 'border-neutral-300', 'focus:border-neutral-950');
      field.removeAttribute('aria-invalid');
    };
    [adminEmailInput, adminPasswordInput].forEach((field) => {
      field.addEventListener('input', () => {
        clearAdminFieldInvalid(field);
        if (adminEmailInput.value.trim() && adminEmailInput.validity.valid && adminPasswordInput.value) {
          adminLoginError.classList.add('hidden');
        }
      });
    });

    document.querySelectorAll('[data-password-toggle]').forEach((toggle) => {
      const password = document.getElementById(toggle.dataset.passwordToggle);
      const label = toggle.dataset.passwordLabel;
      toggle.addEventListener('click', () => {
        const showPassword = password.type === 'password';
        password.type = showPassword ? 'text' : 'password';
        toggle.setAttribute('aria-label', `${showPassword ? 'Hide' : 'Show'} ${label}`);
      });
    });

    document.getElementById('admin-forgot-password').addEventListener('click', (event) => {
      event.preventDefault();
      adminResetEmail.value = adminLoginForm.elements.email.value;
      adminResetError.classList.add('hidden');
      adminResetSuccess.classList.add('hidden');
      adminResetEmailStep.classList.remove('hidden');
      adminResetPasswordStep.classList.add('hidden');
      document.getElementById('admin-reset-close').textContent = 'CLOSE';
      adminResetModal.showModal();
      adminResetEmail.focus();
    });

    document.getElementById('admin-reset-close').addEventListener('click', () => adminResetModal.close());

    document.getElementById('admin-send-reset-code').addEventListener('click', async () => {
      adminResetError.classList.add('hidden');
      if (!adminResetEmail.reportValidity()) return;
      const button = document.getElementById('admin-send-reset-code');
      button.disabled = true;
      button.textContent = 'SENDING…';
      try {
        const response = await fetch('/api/user/forget-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: adminResetEmail.value })
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.message || 'Could not send a reset code.');
        adminResetEmailStep.classList.add('hidden');
        adminResetPasswordStep.classList.remove('hidden');
        document.getElementById('admin-reset-otp').focus();
      } catch (error) {
        adminResetError.textContent = error.message || 'Could not send a reset code.';
        adminResetError.classList.remove('hidden');
      } finally {
        button.disabled = false;
        button.textContent = 'SEND CODE';
      }
    });

    document.getElementById('admin-save-new-password').addEventListener('click', async () => {
      adminResetError.classList.add('hidden');
      const otp = document.getElementById('admin-reset-otp');
      const newPassword = document.getElementById('admin-new-password');
      if (!otp.reportValidity() || !newPassword.reportValidity()) return;
      const button = document.getElementById('admin-save-new-password');
      button.disabled = true;
      button.textContent = 'UPDATING…';
      try {
        const response = await fetch('/api/user/reset-password', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: adminResetEmail.value, otp: otp.value, password: newPassword.value })
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.message || 'Could not update your password.');
        adminResetPasswordStep.classList.add('hidden');
        adminResetSuccess.textContent = 'Your admin password has been updated. You can sign in now.';
        adminResetSuccess.classList.remove('hidden');
        document.getElementById('admin-reset-close').textContent = 'DONE';
      } catch (error) {
        adminResetError.textContent = error.message || 'Could not update your password.';
        adminResetError.classList.remove('hidden');
      } finally {
        button.disabled = false;
        button.textContent = 'UPDATE PASSWORD';
      }
    });

    adminLoginForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      adminLoginError.classList.add('hidden');
      adminLoginSuccess.classList.add('hidden');

      const email = adminEmailInput.value.trim();
      const password = adminPasswordInput.value;
      [adminEmailInput, adminPasswordInput].forEach(clearAdminFieldInvalid);
      const missingFields = [adminEmailInput, adminPasswordInput].filter((field) => !field.value.trim());
      if (missingFields.length) {
        missingFields.forEach(markAdminFieldInvalid);
        adminLoginError.textContent = 'Please fill in the required fields marked in red.';
        adminLoginError.classList.remove('hidden');
        missingFields[0].focus();
        return;
      }
      if (!adminEmailInput.validity.valid) {
        markAdminFieldInvalid(adminEmailInput);
        adminLoginError.textContent = 'Please enter a valid email address.';
        adminLoginError.classList.remove('hidden');
        adminEmailInput.focus();
        return;
      }

      adminLoginSubmit.disabled = true;
      adminLoginSubmit.textContent = 'SIGNING IN…';

      try {
        const response = await fetch(adminLoginForm.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email,
            password
          })
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.message || 'Unable to sign in. Please try again.');
        window.location.replace('/admin/users');
      } catch (error) {
        adminLoginError.textContent = error.message || 'Unable to sign in. Please try again.';
        adminLoginError.classList.remove('hidden');
      } finally {
        adminLoginSubmit.disabled = false;
        adminLoginSubmit.textContent = 'SIGN IN →';
      }
    });
