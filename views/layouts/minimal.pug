
doctype html
html(lang="en", class="scroll-smooth")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title #{title} | Sciss Barber
    script.
      try {
        if (localStorage.getItem('sciss-theme') === 'dark') {
          document.documentElement.classList.add('theme-dark');
        }
      } catch (error) {}

    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
    link(
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Space+Mono&display=swap"
      rel="stylesheet"
    )
    link(rel="stylesheet", href="/css/output.css")

  body(class="flex min-h-dvh flex-col overflow-x-hidden bg-white font-sans text-neutral-950")
    header(class="flex items-center justify-between px-5 py-3 sm:px-8 sm:py-4 lg:px-16")
      a(href="/", class="flex items-center gap-3")

    main(class="flex flex-1 flex-col px-5 sm:px-8 lg:px-16")
      block content

    block auth_actions


