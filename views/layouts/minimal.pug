doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title #{title} | Sciss Barber
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Space+Mono&display=swap", rel="stylesheet")
    link(rel="stylesheet", href="/css/output.css")
    body(class="flex h-dvh flex-col bg-white font-sans text-neutral-950")
    header(class="flex items-center justify-between px-5 py-4 sm:p-[30px]")
      a(href="/", class="flex items-center gap-3")
        span(class="grid size-8 place-items-center bg-neutral-950 font-mono text-[13px] font-bold text-white") SB
        span(class="font-bold tracking-tight") SCISS BARBER 
          span(class="text-neutral-400") / CLIENT PORTAL
      a(href="/login", class="font-mono text-xs tracking-[0.2em] text-neutral-400 hover:text-neutral-950") LOG IN

    main(class="flex min-h-0 flex-1 items-center justify-center overflow-y-auto px-5 py-2")
      block content

    footer(class="flex flex-wrap items-center justify-between gap-4 border-t border-neutral-100 p-5 text-xs text-neutral-400 sm:p-[30px]")
      p © 2026 Sciss Barber Co. Architectural Grooming & Precision Cuts.
      nav(class="flex gap-6")
        a(href="#") Terms of Service
        a(href="#") Privacy Protocol